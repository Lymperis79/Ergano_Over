<Project>
  <!--
    CENTRAL PACKAGE MANAGEMENT (CPM)
    All NuGet package versions for the entire solution are defined here.
    Individual .csproj files reference packages WITHOUT a Version attribute.
    To update a package: change the version here only — all projects pick it up.

    Docs: https://learn.microsoft.com/nuget/consume-packages/central-package-management
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Lets the pinned version below override transitive (indirect) references, e.g. the one pulled in by MailKit/MimeKit. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- ── EF Core ── -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <!--
      MariaDB provider: Official Pomelo does not support EF Core 10 yet.
      Using Microting fork (drop-in replacement, same namespaces).
    -->
    <PackageVersion Include="Microting.EntityFrameworkCore.MySql" Version="10.0.12" />
    <!-- ── Microsoft.Extensions (must match EF Core patch exactly) ── -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <!-- ── Avalonia UI 12.1.2 ── -->
    <PackageVersion Include="Avalonia" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <!-- Security pin: 9.0.11 / 10.0.0 have known vulnerabilities (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7); 10.0.13 is the patched version. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- ── Other dependencies (updated to requested versions) ── -->
    <PackageVersion Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="ClosedXML" Version="0.105.1" />
    <PackageVersion Include="MailKit" Version="4.18.1" />
    <PackageVersion Include="Selenium.WebDriver" Version="4.51.0" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>
</Project>