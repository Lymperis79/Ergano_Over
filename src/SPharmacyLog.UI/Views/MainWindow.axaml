<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SPharmacyLog.UI.Views.MainWindow" Title="S Pharmacy Log" Width="1240" Height="820" MinWidth="980" MinHeight="650" WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBrush}">
  <Grid ColumnDefinitions="230,*" RowDefinitions="*,Auto">
    <Border Grid.Column="0" Grid.RowSpan="2" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
      <StackPanel Margin="18,20" Spacing="16">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}">
            <Grid>
              <TextBlock x:Name="CompanyDefaultIcon" Text="✚" FontSize="25" Foreground="{DynamicResource AccentLightBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
              <Image x:Name="CompanyLogo" Width="38" Height="38" Stretch="Uniform" IsVisible="False"/>
            </Grid>
          </Border>
          <StackPanel VerticalAlignment="Center" Spacing="1">
            <TextBlock x:Name="CompanyNameLabel" Text="S Pharmacy Log" FontWeight="Bold" FontSize="17"/>
            <TextBlock Text="PHARMACY MANAGEMENT" FontSize="9" Foreground="#8293A8"/>
          </StackPanel>
        </StackPanel>
        <StackPanel x:Name="NavigationPanel" Spacing="5"/>
      </StackPanel>
    </Border>
    <Grid Grid.Column="1" Grid.Row="0" RowDefinitions="Auto,*">
      <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" Padding="22,15" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" VerticalAlignment="Center">
          <StackPanel Spacing="2">
            <TextBlock Text="Pharmacy workspace" FontSize="19" FontWeight="SemiBold"/>
            <TextBlock Text="Manage prescriptions, customers and services" FontSize="12" Foreground="#93A2B6"/>
          </StackPanel>
          <TextBlock x:Name="UserLabel" Grid.Column="1" VerticalAlignment="Center" Foreground="#C8D4E2" Margin="0,0,18,0"/>
          <ComboBox x:Name="LanguageBox" Grid.Column="2" Width="130" SelectionChanged="OnLanguageChanged">
            <ComboBoxItem Content="English"/>
            <ComboBoxItem Content="Ελληνικά"/>
          </ComboBox>
          <Button Grid.Column="4" Content="Log out" Margin="8,0,0,0" Click="OnLogoutClick"/>
          <Button Grid.Column="3" Content="🎨" ToolTip.Tip="Appearance and accent colors" Margin="10,0,0,0" Click="OnAppearanceClick"/>
        </Grid>
      </Border>
      <Border Grid.Row="1" Margin="18" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
        <ContentControl x:Name="PageHost"/>
      </Border>
    </Grid>
    <Border Grid.Column="1" Grid.Row="1" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,9">
      <TextBlock Text="S Pharmacy Log  •  Local pharmacy operations" Foreground="#77879A" FontSize="11" HorizontalAlignment="Right"/>
    </Border>
  </Grid>
</Window>