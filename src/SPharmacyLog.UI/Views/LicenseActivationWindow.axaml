<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SPharmacyLog.UI.Views.LicenseActivationWindow" Title="S Pharmacy Log — Licence activation" Width="720" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBrush}">
  <ScrollViewer Padding="28">
    <Border Classes="card" Padding="24">
      <StackPanel Spacing="14">
        <ComboBox x:Name="LanguageBox" Width="130" HorizontalAlignment="Right" SelectionChanged="OnLanguageChanged"><ComboBoxItem Content="English"/><ComboBoxItem Content="Ελληνικά"/></ComboBox>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}">
            <TextBlock Text="🔐" FontSize="23" VerticalAlignment="Center" HorizontalAlignment="Center"/>
          </Border>
          <StackPanel VerticalAlignment="Center" Spacing="2">
            <TextBlock x:Name="TitleText" Text="Activate S Pharmacy Log" FontSize="23" FontWeight="Bold"/>
            <TextBlock x:Name="IntroText" Text="Enter the licence key issued for this PC." TextWrapping="Wrap" Foreground="#91A1B5"/>
          </StackPanel>
        </StackPanel>
        <Border x:Name="InfoBorder" IsVisible="False" Background="{DynamicResource AccentFaintBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
          <TextBlock x:Name="InfoText" TextWrapping="Wrap"/>
        </Border>
        <TextBlock Text="PC code" FontSize="12" Foreground="#91A1B5" FontWeight="SemiBold"/>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox x:Name="PcCodeBox" IsReadOnly="True" FontFamily="Consolas" FontSize="16"/>
          <Button Grid.Column="1" Content="Copy code" Click="OnCopyClick"/>
        </Grid>
        <TextBlock Text="Licence key" FontSize="12" Foreground="#91A1B5" FontWeight="SemiBold"/>
        <TextBox x:Name="KeyBox" AcceptsReturn="True" TextWrapping="Wrap" Height="120" FontFamily="Consolas" FontSize="12"/>
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#F0A65A"/>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button x:Name="LoadButton" Content="Load licence file…" Click="OnLoadClick"/>
          <Button x:Name="ActivateButton" Content="Activate" Classes="accent" Click="OnActivateClick"/>
          <Button x:Name="ExitButton" Content="Exit" Click="OnExitClick"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </ScrollViewer>
</Window>