<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SPharmacyLog.UI.Views.LoginWindow" Icon="avares://SPharmacyLog.UI/Assets/spharmacy.ico" Title="PharmaPoint" Width="480" Height="600" CanResize="False" WindowStartupLocation="CenterScreen" Background="#151922">
  <Grid Margin="28">
    <Border Background="#202733" BorderBrush="#354152" BorderThickness="1"
            CornerRadius="12" VerticalAlignment="Center" Padding="30">
      <StackPanel Spacing="15">
        <Border Width="74" Height="74" CornerRadius="18" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center">
          <TextBlock Text="✚" FontSize="38" Foreground="{DynamicResource AccentLightBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Border>
        <TextBlock x:Name="ProductNameText" Text="PharmaPoint" FontSize="29" FontWeight="Bold" HorizontalAlignment="Center"/>
        <TextBlock x:Name="SubtitleText" Text="Prescription, customer and medicine tracking" Foreground="#91A1B5" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,-5,0,8"/>
        <TextBlock Text="Username" FontWeight="SemiBold"/>
        <TextBox x:Name="UsernameBox" PlaceholderText="Enter your username"/>
        <TextBlock Text="Password" FontWeight="SemiBold"/>
        <TextBox x:Name="PasswordBox" PlaceholderText="Enter your password" PasswordChar="•"/>
        <CheckBox x:Name="RememberCredentialsBox" Content="Remember username and password on this PC" IsChecked="False"/>
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="#F0A65A"/>
        <Button x:Name="SubmitButton" Content="Sign in" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="accent" MinHeight="44" Click="OnSubmitClick"/>
        <TextBlock x:Name="FooterText" Text="Secure pharmacy management" FontSize="12" Foreground="#738397" HorizontalAlignment="Center" Margin="0,6,0,0"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>