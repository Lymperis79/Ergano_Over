<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ErganiManager.UI.ViewModels"
        x:Class="ErganiManager.UI.Views.TerminalView"
        Icon="avares://ErganiManager.UI/Assets/icon.png"
        x:DataType="vm:TerminalViewModel"
        Title="{Binding Loc[ErganiManagerTerminal]}"
        WindowState="Maximized"
        CanResize="False"
        WindowDecorations="None">

    <!-- The terminal is a kiosk: signing out is a keyboard shortcut, not a button employees could press -->
    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+Shift+L" Command="{Binding LogoutCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+Q" Command="{Binding AskExitCommand}" />
        <KeyBinding Gesture="Escape" Command="{Binding CancelExitCommand}" />
    </Window.KeyBindings>

    <Window.Styles>
        <Style Selector="TextBlock.popupTitle"><Setter Property="Foreground" Value="White" /></Style>
        <Style Selector="TextBlock.popupTitle.ok"><Setter Property="Foreground" Value="#66BB6A" /></Style>
        <Style Selector="TextBlock.popupTitle.warn"><Setter Property="Foreground" Value="#FFB74D" /></Style>
        <Style Selector="TextBlock.popupTitle.bad"><Setter Property="Foreground" Value="#EF5350" /></Style>
        <Style Selector="TextBlock.status"><Setter Property="Foreground" Value="#BBBBBB" /></Style>
        <Style Selector="TextBlock.status.ok"><Setter Property="Foreground" Value="#66BB6A" /></Style>
        <Style Selector="TextBlock.status.warn"><Setter Property="Foreground" Value="#FFB74D" /></Style>
        <Style Selector="TextBlock.status.bad"><Setter Property="Foreground" Value="#EF5350" /></Style>
    </Window.Styles>

    <Grid Background="#0F1115" RowDefinitions="2*,*">

        <!-- Main terminal content -->
        <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Spacing="18" Width="600">

            <Image Source="{Binding Logo.Current}" IsVisible="{Binding Logo.HasLogo}"
                   MaxHeight="120" MaxWidth="360" Stretch="Uniform"
                   HorizontalAlignment="Center" Margin="0,0,0,6" />
            <TextBlock IsVisible="{Binding !Logo.HasLogo}" Text="{Binding CompanyName}" FontSize="22" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Foreground="White" />
            <TextBlock HorizontalAlignment="Center" Foreground="#AAAAAA" FontSize="14">
                <Run Text="{Binding Loc[Branch2]}" /><Run Text="{Binding BranchName}" />
            </TextBlock>

            <Border IsVisible="{Binding IsOfflineMode}"
                    Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="8" Margin="0,4,0,0">
                <TextBlock Text="{Binding Loc[OfflineMode]}"
                           Foreground="White" FontSize="12" HorizontalAlignment="Center" />
            </Border>

            <TextBlock Text="{Binding CurrentDateText}" FontSize="18" Foreground="#CCCCCC"
                       HorizontalAlignment="Center" Margin="0,24,0,0" />
            <TextBlock Text="{Binding CurrentTimeText}" FontSize="56" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center" />

            <TextBox Name="ScanInputBox"
                     Text="{Binding ScanInput}"
                     PlaceholderText="{Binding Loc[ScanPrompt]}"
                     FontSize="22" Height="56"
                     HorizontalAlignment="Stretch"
                     HorizontalContentAlignment="Center"
                     Margin="0,32,0,0"
                     IsEnabled="{Binding !IsProcessing}">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding ProcessScanCommand}" />
                </TextBox.KeyBindings>
            </TextBox>

        </StackPanel>

        <!-- Today's scans: scrollable and sized by the available screen area.
             No fixed "last 10" limit; larger displays show more rows at once. -->
        <Border Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="16,0,16,28"
                Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="16,10"
                IsVisible="{Binding HasRecentScans}">
            <Grid RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0" Text="{Binding Loc[RecentScans]}" FontSize="13" FontWeight="SemiBold"
                           Foreground="#AAAAAA" Margin="0,0,0,6" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding RecentScans}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RecentScanItem">
                                <Grid ColumnDefinitions="95,*,120,240" Margin="0,2">
                                    <TextBlock Grid.Column="0" Text="{Binding TimeText}" Foreground="#888888" FontSize="14" />
                                    <TextBlock Grid.Column="1" Text="{Binding EmployeeName}" Foreground="White"
                                               FontSize="14" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding MovementText}" Foreground="#CCCCCC" FontSize="13" />
                                    <TextBlock Grid.Column="3" Text="{Binding StatusText}" Classes="status" FontSize="13"
                                               Classes.ok="{Binding IsOk}" Classes.warn="{Binding IsWarn}"
                                               Classes.bad="{Binding IsBad}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Key hints (kiosk: no buttons that could be pressed by accident) -->
        <TextBlock Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,6"
                   Foreground="#444444" FontSize="11" Text="{Binding Loc[CtrlShiftLLogOutCtrl]}" />

        <!-- Result popup overlay (closes by itself after 2 seconds) -->
        <Border Grid.RowSpan="2" IsVisible="{Binding IsPopupVisible}"
                Background="#CC000000">
            <Border Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="36"
                    Width="560" VerticalAlignment="Center" HorizontalAlignment="Center"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBlock Text="{Binding PopupTitle}" FontSize="24" FontWeight="Bold"
                               Classes="popupTitle" Classes.ok="{Binding IsPopupOk}"
                               Classes.warn="{Binding IsPopupWarn}" Classes.bad="{Binding IsPopupBad}"
                               HorizontalAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding PopupEmployeeName}" FontSize="20"
                               Foreground="#DDDDDD" HorizontalAlignment="Center"
                               Margin="0,8,0,0"
                               IsVisible="{Binding PopupEmployeeName,
                                   Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Text="{Binding PopupDetailLine1}" FontSize="16"
                               Foreground="#BBBBBB" HorizontalAlignment="Center"
                               TextWrapping="Wrap" Margin="0,12,0,0"
                               IsVisible="{Binding PopupDetailLine1,
                                   Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Text="{Binding PopupDetailLine2}" FontSize="16"
                               Foreground="#BBBBBB" HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               IsVisible="{Binding PopupDetailLine2,
                                   Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Text="{Binding PopupDetailLine3}" FontSize="14"
                               Foreground="#888888" HorizontalAlignment="Center"
                               TextWrapping="Wrap" Margin="0,8,0,0"
                               IsVisible="{Binding PopupDetailLine3,
                                   Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </Border>
        </Border>

        <!-- Close the application? -->
        <Border Grid.RowSpan="2" IsVisible="{Binding IsExitConfirmVisible}" Background="#CC000000">
            <Border Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="36" Width="460"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                <StackPanel Spacing="20">
                    <Button Content="✕" Command="{Binding CancelExitCommand}" ToolTip.Tip="Close"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-14,-14,0"
                            Padding="8,4" />
                    <TextBlock Text="{Binding Loc[CloseAppQuestion]}" FontSize="20" FontWeight="SemiBold"
                               Foreground="White" TextWrapping="Wrap" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                        <Button Content="{Binding Loc[Close]}" Command="{Binding ConfirmExitCommand}" Classes="accent" MinWidth="120" />
                        <Button Content="{Binding Loc[Cancel]}" Command="{Binding CancelExitCommand}" MinWidth="120" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

    </Grid>

</Window>
