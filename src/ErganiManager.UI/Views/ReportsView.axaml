<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ErganiManager.UI.ViewModels"
             xmlns:core="using:ErganiManager.Core.Interfaces"
             x:Class="ErganiManager.UI.Views.ReportsView"
             x:DataType="vm:ReportsViewModel">

    <UserControl.Styles>
        <Style Selector="Border.rgroup"><Setter Property="Background" Value="#252B36" /></Style>
        <Style Selector="Border.rtotal"><Setter Property="Background" Value="#1F2F3F" /></Style>
        <Style Selector="TextBlock.strong"><Setter Property="FontWeight" Value="SemiBold" /></Style>
        <Style Selector="TextBlock.warn"><Setter Property="Foreground" Value="#FFB74D" /></Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <!-- One table row: a horizontal line of fixed-width cells -->
        <DataTemplate x:Key="ReportRowTemplate" x:DataType="core:ReportRow">
            <Border Padding="4,3" CornerRadius="4"
                    Classes.rgroup="{Binding IsGroup}" Classes.rtotal="{Binding IsTotal}">
                <ItemsControl ItemsSource="{Binding Cells}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="core:ReportCell">
                            <TextBlock Text="{Binding Text}" Width="{Binding Width}" TextTrimming="CharacterEllipsis"
                                       Classes.strong="{Binding IsStrong}" Classes.warn="{Binding IsWarn}"
                                       ToolTip.Tip="{Binding Text}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14">

            <Border IsVisible="{Binding !HasActiveCompany}" Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="14">
                <TextBlock Text="{Binding NoCompanyMessage}" TextWrapping="Wrap" />
            </Border>

            <StackPanel IsVisible="{Binding HasActiveCompany}" Spacing="14">

                <TextBlock Text="{Binding Loc[NavReports]}" FontSize="22" FontWeight="Bold" />

                <!-- Report selector -->
                <WrapPanel HorizontalAlignment="Left" MaxWidth="{Binding $parent[ScrollViewer].Viewport.Width}">
                    <RadioButton GroupName="ReportKind" Content="{Binding Loc[Overtime]}" Margin="0,0,16,4"
                                 IsChecked="{Binding IsOvertimeReport, Mode=TwoWay}" />
                    <RadioButton GroupName="ReportKind" Content="{Binding Loc[TotalWorkingTime]}" Margin="0,0,16,4"
                                 IsChecked="{Binding IsWorkTimeReport, Mode=TwoWay}" />
                    <RadioButton GroupName="ReportKind" Content="{Binding Loc[DeclaredVsActual]}" Margin="0,0,16,4"
                                 IsChecked="{Binding IsCompareReport, Mode=TwoWay}" />
                    <RadioButton GroupName="ReportKind" Content="{Binding Loc[AttendanceReport]}" Margin="0,0,16,4"
                                 IsChecked="{Binding IsAttendanceReport, Mode=TwoWay}" />
                    <RadioButton GroupName="ReportKind" Content="{Binding Loc[MonthlyPayrollReport]}" Margin="0,0,16,4"
                                 IsChecked="{Binding IsPayrollReport, Mode=TwoWay}" />
                </WrapPanel>

                <!-- Analysis reports (shown as tables) -->
                <TextBlock Text="{Binding Loc[Analysis]}" FontSize="12" Foreground="Gray" Margin="0,2,0,-8" />
                <WrapPanel HorizontalAlignment="Left" MaxWidth="{Binding $parent[ScrollViewer].Viewport.Width}">
                    <RadioButton GroupName="ReportKind" Content="{Binding Loc[RoundingImpact]}" Margin="0,0,16,4"
                                 IsChecked="{Binding IsRoundingReport, Mode=TwoWay}" />
                    <RadioButton GroupName="ReportKind" Content="{Binding Loc[SubmissionStatus]}" Margin="0,0,16,4"
                                 IsChecked="{Binding IsSubmissionReport, Mode=TwoWay}" />
                    <RadioButton GroupName="ReportKind" Content="{Binding Loc[RetryFailureLog]}" Margin="0,0,16,4"
                                 IsChecked="{Binding IsFailureLogReport, Mode=TwoWay}" />
                    <RadioButton GroupName="ReportKind" Content="{Binding Loc[ScheduleConsistency]}" Margin="0,0,16,4"
                                 IsChecked="{Binding IsConsistencyReport, Mode=TwoWay}" />
                    <RadioButton GroupName="ReportKind" Content="{Binding Loc[Roster]}" Margin="0,0,16,4"
                                 IsChecked="{Binding IsRosterReport, Mode=TwoWay}" />
                    <RadioButton GroupName="ReportKind" Content="{Binding Loc[OvertimeTrend]}" Margin="0,0,16,4"
                                 IsChecked="{Binding IsTrendReport, Mode=TwoWay}" />
                    <RadioButton GroupName="ReportKind" Content="{Binding Loc[OvertimeExtraHoursAnalysis]}" Margin="0,0,16,4"
                                 IsChecked="{Binding IsOvertimeAnalysisReport, Mode=TwoWay}" />
                    <RadioButton GroupName="ReportKind" Content="{Binding Loc[Holidays]}" Margin="0,0,16,4"
                                 IsChecked="{Binding IsHolidaysReport, Mode=TwoWay}" />
                </WrapPanel>

                <!-- Filters -->
                <WrapPanel HorizontalAlignment="Left" MaxWidth="{Binding $parent[ScrollViewer].Viewport.Width}">
                    <StackPanel Spacing="4" Margin="0,0,12,8">
                        <TextBlock Text="{Binding Loc[From]}" FontSize="12" Foreground="Gray" />
                        <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}" MinWidth="150" />
                    </StackPanel>
                    <StackPanel Spacing="4" Margin="0,0,12,8">
                        <TextBlock Text="{Binding Loc[To]}" FontSize="12" Foreground="Gray" />
                        <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}" MinWidth="150" />
                    </StackPanel>
                    <StackPanel Spacing="4" Margin="0,0,12,8">
                        <TextBlock Text="{Binding Loc[Employee]}" FontSize="12" Foreground="Gray" />
                        <ComboBox ItemsSource="{Binding AvailableEmployees}"
                                  SelectedItem="{Binding SelectedEmployee}" MinWidth="220"
                                  ToolTip.Tip="Type an employee name to find them quickly">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="core:EmployeeDto"><TextBlock Text="{Binding FullName}" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom" Margin="0,0,0,8">
                        <Button Content="{Binding Loc[Generate]}" Command="{Binding GenerateCommand}" Classes="accent" />
                        <Button Content="{Binding Loc[ExportCSV]}" Click="OnExportClick" IsEnabled="{Binding CanExport}" />
                        <Button Content="{Binding ExcelExportButtonLabel}" Click="OnExportExcelClick" IsEnabled="{Binding HasActiveCompany}" />
                    </StackPanel>
                </WrapPanel>

                <TextBlock Text="{Binding StatusMessage}" Foreground="Gray" FontSize="12" TextWrapping="Wrap" />

                <!-- Totals per employee + grand total -->
                <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="16" IsVisible="{Binding HasData}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding ReportTitle}" FontWeight="SemiBold" FontSize="15" />
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="18" IsVisible="{Binding IsCompareReport}">
                            <TextBlock Grid.Column="1" Text="{Binding Loc[Actual]}" Foreground="Gray" FontSize="11" />
                            <TextBlock Grid.Column="2" Text="{Binding $parent[UserControl].DataContext.Loc[ReportNightHours]}" Foreground="Gray" FontSize="11" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="18" IsVisible="{Binding IsWorkTimeReport}">
                            <TextBlock Grid.Column="1" Text="{Binding Loc[ScheduledHMm]}" Foreground="Gray" FontSize="11" />
                            <TextBlock Grid.Column="2" Text="{Binding Loc[ActualWorkedHMm]}" Foreground="Gray" FontSize="11" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="18" IsVisible="{Binding IsPayrollReport}">
                            <TextBlock Grid.Column="1" Text="{Binding Loc[PayrollActualHours]}" Foreground="Gray" FontSize="11" />
                            <TextBlock Grid.Column="2" Text="{Binding Loc[PayrollNightHours]}" Foreground="Gray" FontSize="11" />
                            <TextBlock Grid.Column="3" Text="{Binding Loc[PayrollRecordedOvertime]}" Foreground="Gray" FontSize="11" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding EmployeeTotals}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="core:ReportEmployeeTotal">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="18">
                                        <TextBlock Text="{Binding EmployeeName}" />
                                        <TextBlock Grid.Column="1" Text="{Binding HoursText}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2" Text="{Binding NightHoursText}" FontWeight="SemiBold" Foreground="#81D4FA"
                                                   IsVisible="{Binding $parent[ItemsControl].((vm:ReportsViewModel)DataContext).IsCompareReport}" />
                                        <TextBlock Grid.Column="2" Text="{Binding ActualHoursText}" FontWeight="SemiBold" Foreground="#81C784"
                                                   IsVisible="{Binding $parent[ItemsControl].((vm:ReportsViewModel)DataContext).IsWorkTimeReport}" />
                                        <TextBlock Grid.Column="2" Text="{Binding NightHoursText}" FontWeight="SemiBold" Foreground="#81D4FA"
                                                   IsVisible="{Binding $parent[ItemsControl].((vm:ReportsViewModel)DataContext).IsPayrollReport}" />
                                        <TextBlock Grid.Column="3" Text="{Binding ActualHoursText}" FontWeight="SemiBold" Foreground="#FFB74D"
                                                   IsVisible="{Binding $parent[ItemsControl].((vm:ReportsViewModel)DataContext).IsPayrollReport}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Height="1" Background="#33FFFFFF" Margin="0,4" />
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsCompareReport}">
                            <TextBlock Text="{Binding TotalsLabel}" FontWeight="Bold" />
                            <TextBlock Grid.Column="1" Text="{Binding GrandTotalText}" FontWeight="Bold" FontSize="16" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsCompareReport}">
                            <TextBlock Text="{Binding $parent[UserControl].DataContext.Loc[ReportNightHours]}" FontWeight="Bold" />
                            <TextBlock Grid.Column="1" Text="{Binding NightTotalText}" FontWeight="Bold" FontSize="16" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding !IsCompareReport}">
                            <TextBlock Text="{Binding TotalsLabel}" FontWeight="Bold" />
                            <TextBlock Grid.Column="1" Text="{Binding GrandTotalText}" FontWeight="Bold" FontSize="16" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsPayrollReport}">
                            <TextBlock Text="{Binding Loc[PayrollNightHours]}" FontWeight="Bold" />
                            <TextBlock Grid.Column="1" Text="{Binding NightTotalText}" FontWeight="Bold" FontSize="16" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsPayrollReport}">
                            <TextBlock Text="{Binding Loc[PayrollRecordedOvertime]}" FontWeight="Bold" />
                            <TextBlock Grid.Column="1" Text="{Binding ActualTotalText}" FontWeight="Bold" FontSize="16" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsWorkTimeReport}">
                            <TextBlock Text="{Binding ActualTotalsLabel}" FontWeight="Bold" />
                            <TextBlock Grid.Column="1" Text="{Binding ActualTotalText}" FontWeight="Bold" FontSize="16" Foreground="#81C784" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Overtime report: one block per employee + month -->
                <ItemsControl ItemsSource="{Binding OvertimeMonths}" IsVisible="{Binding IsOvertimeReport}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="core:OvertimeReportMonth">
                            <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="14,10">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock Grid.Column="1" Text="{Binding TotalText, StringFormat='Month total: {0}'}"
                                                   FontWeight="Bold" Foreground="{DynamicResource AccentLightBrush}" />
                                    </Grid>
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="360">
                                    <ItemsControl ItemsSource="{Binding Records}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="core:OvertimeDto">
                                                <Grid ColumnDefinitions="110,130,70,*,90" Margin="0,2">
                                                    <TextBlock Text="{Binding OvertimeDate, StringFormat='{}{0:dd/MM/yyyy}'}" />
                                                    <TextBlock Grid.Column="1">
                                                        <Run Text="{Binding StartTime, StringFormat='{}{0:HH:mm}'}" />
                                                        <Run Text="→" />
                                                        <Run Text="{Binding EndTime, StringFormat='{}{0:HH:mm}'}" />
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="2" Text="{Binding HoursWorked, StringFormat='{}{0:0.##} h'}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding JustificationLabel}" Foreground="Gray" />
                                                    <TextBlock Grid.Column="4" Text="{Binding SubmittedToErgani, Converter={x:Static vm:SentTextConverter.Instance}}"
                                                               Foreground="Gray" HorizontalAlignment="Right" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Declared vs actual: one block per employee + month, one line per day -->
                <ScrollViewer IsVisible="{Binding IsCompareOrPayrollReport}"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              MaxHeight="600">
                    <ItemsControl ItemsSource="{Binding SummaryMonths}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="core:TimeSummaryMonth" x:CompileBindings="False">
                                <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="14,10" MinWidth="1180">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="14" />
                                            <TextBlock Grid.Column="1" Text="{Binding TotalsText}" FontWeight="Bold" Foreground="{DynamicResource AccentLightBrush}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="120,130,180,70,200,80,100,90,120,80,100" ColumnSpacing="8">
                                            <TextBlock Text="{Binding $parent[UserControl].DataContext.Loc[Date]}" Foreground="Gray" FontSize="11" />
                                            <TextBlock Grid.Column="1" Text="{Binding $parent[UserControl].DataContext.Loc[Declared]}" Foreground="Gray" FontSize="11" />
                                            <TextBlock Grid.Column="2" Text="{Binding $parent[UserControl].DataContext.Loc[Holidays]}" Foreground="Gray" FontSize="11" />
                                            <TextBlock Grid.Column="3" Text="{Binding $parent[UserControl].DataContext.Loc[Hours]}" Foreground="Gray" FontSize="11" />
                                            <TextBlock Grid.Column="4" Text="{Binding $parent[UserControl].DataContext.Loc[Actual]}" Foreground="Gray" FontSize="11" />
                                            <TextBlock Grid.Column="5" Text="{Binding $parent[UserControl].DataContext.Loc[ActualHours]}" Foreground="Gray" FontSize="11" />
                                            <TextBlock Grid.Column="6" Text="{Binding $parent[UserControl].DataContext.Loc[ReportNightHours]}" Foreground="Gray" FontSize="11" />
                                            <TextBlock Grid.Column="7" Text="{Binding $parent[UserControl].DataContext.Loc[Rounded]}" Foreground="Gray" FontSize="11" />
                                            <TextBlock Grid.Column="8" Text="{Binding $parent[UserControl].DataContext.Loc[RoundedInOut]}" Foreground="Gray" FontSize="11" />
                                            <TextBlock Grid.Column="9" Text="{Binding $parent[UserControl].DataContext.Loc[Difference]}" Foreground="Gray" FontSize="11" />
                                            <TextBlock Grid.Column="10" Text="{Binding $parent[UserControl].DataContext.Loc[OvertimeTotal]}" Foreground="Gray" FontSize="11" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Days}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="core:DayTimeRow">
                                                    <Grid ColumnDefinitions="120,130,180,70,200,80,100,90,120,80,100" ColumnSpacing="8" Margin="0,2">
                                                        <TextBlock Text="{Binding DateText}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding DeclaredText}" />
                                                        <TextBlock Grid.Column="2" Text="{Binding HolidayType}" TextWrapping="Wrap" />
                                                        <TextBlock Grid.Column="3" Text="{Binding DeclaredHoursText}" />
                                                        <ItemsControl Grid.Column="4" ItemsSource="{Binding Pairs}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="core:ScanPair">
                                                                    <TextBlock Text="{Binding Line}" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBlock Grid.Column="5" Text="{Binding ActualHoursText}"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Grid.Column="6" Text="{Binding NightHoursText}" FontWeight="SemiBold" Foreground="#81D4FA" />
                                                        <TextBlock Grid.Column="7" Text="{Binding RoundedHoursText}" FontWeight="SemiBold" Foreground="#CE93D8" />
                                                        <TextBlock Grid.Column="8" Text="{Binding RoundedInOutText}" Foreground="#CE93D8" />
                                                        <TextBlock Grid.Column="9" Text="{Binding DiffText}" Foreground="#9CCC65" />
                                                        <TextBlock Grid.Column="10" Text="{Binding OvertimeText}" Foreground="#FFB74D" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Working time report: one row per employee + month -->
                <StackPanel IsVisible="{Binding IsWorkTimeReport}" Spacing="4">
                    <Grid ColumnDefinitions="*,90,70,140,140,150,120" Margin="14,0">
                        <TextBlock Text="{Binding Loc[Employee]}" Foreground="Gray" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="{Binding Loc[Month]}" Foreground="Gray" FontSize="12" />
                        <TextBlock Grid.Column="2" Text="{Binding Loc[Days]}" Foreground="Gray" FontSize="12" />
                        <TextBlock Grid.Column="3" Text="{Binding Loc[ScheduledHMm]}" Foreground="Gray" FontSize="12" />
                        <TextBlock Grid.Column="4" Text="{Binding Loc[ActualWorkedHMm]}" Foreground="Gray" FontSize="12" />
                        <TextBlock Grid.Column="5" Text="{Binding Loc[Normal8hDay]}" Foreground="Gray" FontSize="12" />
                        <TextBlock Grid.Column="6" Text="{Binding Loc[Over8hDay]}" Foreground="Gray" FontSize="12" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding WorkTimeRows}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="core:WorkTimeReportRow">
                                <Border Background="{DynamicResource CardBrush}" CornerRadius="6" Padding="14,8">
                                    <Grid ColumnDefinitions="*,90,70,140,140,150,120">
                                        <TextBlock Text="{Binding EmployeeName}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding MonthLabel}" />
                                        <TextBlock Grid.Column="2" Text="{Binding DaysWorked}" />
                                        <TextBlock Grid.Column="3" Text="{Binding TotalText}" FontWeight="Bold" Foreground="{DynamicResource AccentLightBrush}" />
                                        <TextBlock Grid.Column="4" Text="{Binding ActualText}" FontWeight="Bold" Foreground="#81C784"
                                                   ToolTip.Tip="{Binding DiffText}" />
                                        <TextBlock Grid.Column="5" Text="{Binding NormalText}" />
                                        <TextBlock Grid.Column="6" Text="{Binding OverText}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Attendance and punctuality report: one row per employee/day -->
                <ScrollViewer IsVisible="{Binding IsAttendanceReport}"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              MaxHeight="560">
                    <StackPanel MinWidth="1540" Spacing="4">
                        <Grid ColumnDefinitions="190,100,100,80,80,150,150,100,100,85,100,220" ColumnSpacing="8" Margin="12,0">
                            <TextBlock Text="{Binding Loc[Employee]}" Foreground="Gray" FontSize="11" />
                            <TextBlock Grid.Column="1" Text="{Binding Loc[Date]}" Foreground="Gray" FontSize="11" />
                            <TextBlock Grid.Column="2" Text="{Binding Loc[AttendanceScheduleType]}" Foreground="Gray" FontSize="11" />
                            <TextBlock Grid.Column="3" Text="{Binding Loc[AttendanceScheduledStart]}" Foreground="Gray" FontSize="11" />
                            <TextBlock Grid.Column="4" Text="{Binding Loc[AttendanceScheduledEnd]}" Foreground="Gray" FontSize="11" />
                            <TextBlock Grid.Column="5" Text="{Binding Loc[AttendanceFirstArrival]}" Foreground="Gray" FontSize="11" />
                            <TextBlock Grid.Column="6" Text="{Binding Loc[AttendanceLastDeparture]}" Foreground="Gray" FontSize="11" />
                            <TextBlock Grid.Column="7" Text="{Binding Loc[AttendanceScheduledHours]}" Foreground="Gray" FontSize="11" />
                            <TextBlock Grid.Column="8" Text="{Binding Loc[ActualHours]}" Foreground="Gray" FontSize="11" />
                            <TextBlock Grid.Column="9" Text="{Binding Loc[AttendanceLateMinutes]}" Foreground="Gray" FontSize="11" />
                            <TextBlock Grid.Column="10" Text="{Binding Loc[AttendanceEarlyDepartureMinutes]}" Foreground="Gray" FontSize="11" />
                            <TextBlock Grid.Column="11" Text="{Binding Loc[AttendanceStatus]}" Foreground="Gray" FontSize="11" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding AttendanceRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="core:AttendanceReportRow">
                                    <Border Background="{DynamicResource CardBrush}" CornerRadius="6" Padding="12,8" Margin="0,2">
                                        <Grid ColumnDefinitions="190,100,100,80,80,150,150,100,100,85,100,220" ColumnSpacing="8">
                                            <TextBlock Text="{Binding EmployeeName}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="{Binding DateText}" />
                                            <TextBlock Grid.Column="2" Text="{Binding ScheduleKindText}" />
                                            <TextBlock Grid.Column="3" Text="{Binding ScheduledStartText}" />
                                            <TextBlock Grid.Column="4" Text="{Binding ScheduledEndText}" />
                                            <TextBlock Grid.Column="5" Text="{Binding FirstArrivalText}" />
                                            <TextBlock Grid.Column="6" Text="{Binding LastDepartureText}" />
                                            <TextBlock Grid.Column="7" Text="{Binding ScheduledHoursText}" />
                                            <TextBlock Grid.Column="8" Text="{Binding ActualHoursText}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="9" Text="{Binding LateText}" Foreground="#EF5350" />
                                            <TextBlock Grid.Column="10" Text="{Binding EarlyDepartureText}" Foreground="#FFB74D" />
                                            <TextBlock Grid.Column="11" Text="{Binding Status}" TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Analysis reports: one block per table section -->
                <ItemsControl ItemsSource="{Binding TableSections}" IsVisible="{Binding HasTableData}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Spacing="14" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="core:TableSection">
                            <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="14,10">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{Binding Title}" IsVisible="{Binding HasTitle}"
                                               FontWeight="SemiBold" FontSize="15" />
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <StackPanel Spacing="2">
                                            <ContentControl Content="{Binding HeaderRow}"
                                                            ContentTemplate="{StaticResource ReportRowTemplate}" />
                                            <ItemsControl ItemsSource="{Binding DisplayRows}"
                                                          ItemTemplate="{StaticResource ReportRowTemplate}" />
                                        </StackPanel>
                                    </ScrollViewer>
                                    <TextBlock Text="{Binding DisplayNote}" IsVisible="{Binding HasNote}"
                                               Foreground="Gray" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
