<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ErganiManager.UI.ViewModels"
             x:Class="ErganiManager.UI.Views.OvertimeView"
             x:DataType="vm:OvertimeViewModel">

    <Grid>
        <!-- Keep filters fixed while the records list fills the remaining window height. -->
        <Grid RowDefinitions="*" Margin="0,0,0,0">

            <Border Grid.Row="0" IsVisible="{Binding !HasActiveCompany}" Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="14">
                <TextBlock Text="{Binding NoCompanyMessage}" TextWrapping="Wrap" />
            </Border>

            <Grid Grid.Row="0" IsVisible="{Binding HasActiveCompany}" RowDefinitions="Auto,Auto,*" RowSpacing="12">

                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding Loc[Overtime]}" FontSize="22" FontWeight="Bold" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <DatePicker SelectedDate="{Binding FilterFrom, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="150" />
                        <TextBlock Text="→" VerticalAlignment="Center" />
                        <DatePicker SelectedDate="{Binding FilterTo, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="150" />
                        <Button Content="{Binding Loc[Load]}" Command="{Binding LoadRecordsCommand}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="{Binding Loc[SubmitSelected]}" Command="{Binding SubmitSelectedCommand}" IsEnabled="{Binding HasSelection}" Margin="8,0,0,0" />
                    <Button Grid.Column="3" Content="{Binding Loc[New]}" Command="{Binding StartCreateCommand}" Classes="accent" Margin="8,0,0,0" />
                </Grid>

                <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Foreground="Gray" FontSize="12" TextWrapping="Wrap" />

                <!-- Overtime records list -->
                <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" VerticalAlignment="Stretch">
                <ItemsControl ItemsSource="{Binding Records}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                            <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="14,10">
                                <Grid MinWidth="1100" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                                    <CheckBox Grid.Column="0" Tag="{Binding}" Click="OnSelectionClick" IsVisible="{Binding !SubmittedToErgani}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding EmployeeFullName}" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock Text="{Binding BranchName}" FontSize="11" Foreground="Gray" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Margin="12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding OvertimeDate, StringFormat='{}{0:dd/MM/yyyy}'}"
                                                   FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding StartTime, StringFormat='{}{0:HH:mm}'}"
                                                   FontSize="12" Foreground="Gray" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Margin="8,0"
                                               Text="{Binding EndTime, StringFormat='→ {0:HH:mm}'}"
                                               Foreground="#AAAAAA" FontSize="12" />

                                    <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="8,0" Spacing="4">
                                        <Border CornerRadius="10" Padding="8,3"
                                                Background="{Binding IsCancelled, Converter={x:Static vm:BoolToBackgroundConverter.Instance}}">
                                            <TextBlock Text="{Binding IsCancelled, Converter={x:Static vm:CancelledTextConverter.Instance}}"
                                                       FontSize="11" Foreground="White" />
                                        </Border>
                                        <TextBlock Text="{Binding $parent[UserControl].DataContext.Loc[Pending]}"
                                                   FontSize="11" Foreground="#FFB74D"
                                                   IsVisible="{Binding !SubmittedToErgani}" />
                                        <TextBlock Text="{Binding $parent[UserControl].DataContext.Loc[Sent]}"
                                                   FontSize="11" Foreground="#81C784"
                                                   IsVisible="{Binding SubmittedToErgani}" />
                                        <TextBlock Text="{Binding Protocol}" FontSize="10" Foreground="#888888"
                                                   IsVisible="{Binding Protocol, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>

                                    <Button Grid.Column="5" Content="{Binding $parent[UserControl].DataContext.Loc[ResponseLabel]}" Tag="{Binding}" Click="OnResponseClick" IsEnabled="{Binding SubmittedToErgani}" Margin="0,0,6,0" />
                                    <Button Grid.Column="6" Content="{Binding $parent[UserControl].DataContext.Loc[PdfLabel]}" Tag="{Binding}" Click="OnPdfClick" IsEnabled="{Binding SubmittedToErgani}" Margin="0,0,6,0" />
                                    <Button Grid.Column="7" Content="{Binding $parent[UserControl].DataContext.Loc[CancelOvertimeLabel]}" Tag="{Binding}"
                                            Click="OnCancelClick"
                                            IsEnabled="{Binding !IsCancelled}"
                                            Margin="0,0,6,0" />
                                    <Button Grid.Column="8" Content="{Binding $parent[UserControl].DataContext.Loc[Delete]}" Tag="{Binding}"
                                            Click="OnDeleteClick" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>

        </Grid>
        </Grid>

        <!-- Ergani response viewer -->
        <Border IsVisible="{Binding IsResponseOpen}" Background="#AA000000" ZIndex="100">
            <Border Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="20" Width="800" Height="600" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                    <Button Content="✕" Command="{Binding CloseResponseCommand}" ToolTip.Tip="Close"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-14,-14,0"
                            Padding="8,4" />
                    <TextBlock Grid.Row="0" Text="{Binding ResponseTitle}" FontSize="17" FontWeight="Bold" />
                    <TextBox Grid.Row="1" Text="{Binding ResponseText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="{x:Static ScrollBarVisibility.Auto}" ScrollViewer.HorizontalScrollBarVisibility="{x:Static ScrollBarVisibility.Auto}" FontFamily="Consolas" />
                    <Button Grid.Row="2" Content="{Binding Loc[Close]}" Command="{Binding CloseResponseCommand}" HorizontalAlignment="Right" Width="100" />
                </Grid>
            </Border>
        </Border>

        <!-- New overtime form overlay -->
        <Border IsVisible="{Binding IsCreating}" Background="#AA000000">
            <Border Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="24"
                    Width="760" MaxWidth="900" MaxHeight="900" VerticalAlignment="Center" HorizontalAlignment="Center"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                <ScrollViewer MaxHeight="850" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding Loc[NewOvertimeEntry]}" FontSize="18" FontWeight="Bold" />

                    <TextBlock Text="{Binding Loc[Employees]}" FontWeight="SemiBold" />
                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="10">
                        <ItemsControl ItemsSource="{Binding FormEmployeeOptions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding FullName}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Margin="2,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <TextBlock Text="{Binding Loc[Branch]}" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding AvailableBranches}" SelectedItem="{Binding FormBranch}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="{Binding Loc[OvertimeDate]}" FontWeight="SemiBold" />
                    <DatePicker SelectedDate="{Binding FormDate, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="150" />

                    <Grid ColumnDefinitions="*,24,*" ColumnSpacing="12">
                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="{Binding Loc[StartTime]}" FontWeight="SemiBold" FontSize="12" />
                            <TimePicker SelectedTime="{Binding FormStartTime}" ClockIdentifier="24HourClock"
                                        HorizontalAlignment="Stretch" MinWidth="0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="→" HorizontalAlignment="Center"
                                   VerticalAlignment="Bottom" Padding="0,0,0,10" FontSize="16" />
                        <StackPanel Grid.Column="2" Spacing="6">
                            <TextBlock Text="{Binding Loc[EndTime]}" FontWeight="SemiBold" FontSize="12" />
                            <TimePicker SelectedTime="{Binding FormEndTime}" ClockIdentifier="24HourClock"
                                        HorizontalAlignment="Stretch" MinWidth="0" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding Loc[Justification]}" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding Justifications}" SelectedItem="{Binding FormJustification}"
                              HorizontalAlignment="Stretch" />

                    <TextBlock Text="{Binding Loc[WeeklyWorkdays]}" FontWeight="SemiBold" />
                    <NumericUpDown Value="{Binding FormWeeklyWorkdays}" Minimum="5" Maximum="6" />

                    <TextBlock Text="{Binding Loc[ASEEApprovalNumberIfApplicable]}" FontWeight="SemiBold" />
                    <TextBox Text="{Binding FormAseeApproval}" />

                    <TextBlock Text="{Binding StatusMessage}" Foreground="Red" TextWrapping="Wrap"
                               IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <Grid ColumnDefinitions="*,*" Margin="0,12,0,0">
                        <Button Grid.Column="0" Content="{Binding Loc[Cancel]}" Command="{Binding CancelCreateCommand}"
                                HorizontalAlignment="Stretch" Margin="0,0,6,0" />
                        <Button Grid.Column="1" Content="{Binding Loc[Save]}" Command="{Binding SaveCommand}"
                                Classes="accent" HorizontalAlignment="Stretch" Margin="6,0,0,0" />
                    </Grid>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>
    </Grid>

</UserControl>
