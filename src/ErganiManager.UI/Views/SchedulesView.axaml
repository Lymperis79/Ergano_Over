<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ErganiManager.UI.ViewModels"
             xmlns:views="using:ErganiManager.UI.Views"
             xmlns:core="using:ErganiManager.Core.Interfaces"
             x:Class="ErganiManager.UI.Views.SchedulesView"
             x:DataType="vm:SchedulesViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- Compact command bar with clearly marked dropdown menus. -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*"
              Margin="0,0,0,8" ColumnSpacing="8" VerticalAlignment="Top">
            <Menu Grid.Column="0" VerticalAlignment="Center">
                <MenuItem>
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding Loc[ScheduleActionsMenu]}" />
                            <TextBlock Text="▾" Opacity="0.8" />
                        </StackPanel>
                    </MenuItem.Header>
                    <MenuItem Header="{Binding Loc[Import2]}" Command="{Binding RequestImportCommand}" IsEnabled="{Binding HasActiveCompany}" />
                    <MenuItem Header="{Binding Loc[ImportHistory]}" Command="{Binding OpenImportHistoryCommand}" IsEnabled="{Binding HasActiveCompany}" />
                    <Separator />
                    <MenuItem Header="{Binding Loc[BulkApply]}" Command="{Binding OpenBulkDialogCommand}" IsEnabled="{Binding HasActiveCompany}" />
                    <MenuItem Header="{Binding Loc[CloneTo]}" Command="{Binding OpenCloneDialogCommand}" IsEnabled="{Binding HasActiveCompany}" />
                    <MenuItem Header="{Binding Loc[UndoLastClone]}" Command="{Binding OpenUndoCloneDialogCommand}" IsEnabled="{Binding CanUndoLastClone}" />
                    <Separator />
                    <MenuItem Header="{Binding Loc[ExportMonth]}" Command="{Binding ExportMonthCommand}" IsEnabled="{Binding HasActiveCompany}" />
                </MenuItem>
            </Menu>

            <Menu Grid.Column="1" VerticalAlignment="Center">
                <MenuItem>
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding Loc[SubmissionActionsMenu]}" />
                            <TextBlock Text="▾" Opacity="0.8" />
                        </StackPanel>
                    </MenuItem.Header>
                    <MenuItem Header="{Binding Loc[ScheduleSubmission]}" Command="{Binding SubmitScheduleToErganiCommand}" IsEnabled="{Binding HasActiveCompany}" />
                    <MenuItem Header="{Binding Loc[AllPendingSchedulesAllEmployees]}" Command="{Binding PrepareSubmitAllPendingSchedulesCommand}" IsEnabled="{Binding HasActiveCompany}" />                   
                    <Separator />
                    <MenuItem Header="{Binding Loc[OvertimeSubmission]}" Command="{Binding SubmitOvertimesCommand}" IsEnabled="{Binding HasActiveCompany}" />
                    <MenuItem Header="{Binding Loc[AllOvertimes]}" Command="{Binding PrepareSubmitAllOvertimesCommand}" IsEnabled="{Binding HasActiveCompany}" />
                    <Separator />
                    <MenuItem Header="{Binding Loc[HolidaySubmission]}" Command="{Binding SubmitHolidaysCommand}" IsEnabled="{Binding HasActiveCompany}" />
                    <MenuItem Header="{Binding Loc[AllHolidays]}" Command="{Binding PrepareSubmitAllHolidaysCommand}" IsEnabled="{Binding HasActiveCompany}" />
                </MenuItem>
            </Menu>

            <Menu Grid.Column="2" VerticalAlignment="Center">
                <MenuItem>
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding Loc[LogsMenu]}" />
                            <TextBlock Text="▾" Opacity="0.8" />
                        </StackPanel>
                    </MenuItem.Header>
                    <MenuItem Header="{Binding Loc[Log]}" Command="{Binding OpenLogCommand}" IsEnabled="{Binding HasActiveCompany}" />
                    <MenuItem Header="{Binding Loc[OvertimeLog]}" Command="{Binding OpenOvertimeLogCommand}" IsEnabled="{Binding HasActiveCompany}" />
                    <MenuItem Header="{Binding Loc[HolidaysLog]}" Command="{Binding OpenHolidaysLogCommand}" IsEnabled="{Binding HasActiveCompany}" />
                </MenuItem>
            </Menu>

            <Button Grid.Column="3" Content="{Binding Loc[AddHolidays]}"
                    Command="{Binding OpenHolidaysCommand}" IsEnabled="{Binding HasActiveCompany}"
                    Padding="12,8" />

            <Button Grid.Column="4" HorizontalAlignment="Left"
                    Content="{Binding Loc[OpenErganiPortal]}"
                    Command="{Binding OpenErganiPortalCommand}"
                    IsEnabled="{Binding HasActiveCompany}"
                    Padding="12,8" />
        </Grid>

        <!-- Row 1: Controls bar -->
        <Border Grid.Row="1" Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,8">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto">

                <!-- Employee picker -->
                <TextBlock Grid.Column="0" Text="{Binding Loc[Employee2]}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableEmployees}"
                          SelectedItem="{Binding SelectedEmployee}" Width="200"
                          ToolTip.Tip="Type an employee name to find them quickly">
                    <ComboBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding FullName}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- View mode -->
                <Button Grid.Column="2" Content="{Binding Loc[Month]}"
                        Command="{Binding SetViewModeCommand}" CommandParameter="Month"
                        Margin="12,0,4,0"
                        Classes.accent="{Binding IsMonthView}" />
                <Button Grid.Column="3" Content="{Binding Loc[Week]}"
                        Command="{Binding SetViewModeCommand}" CommandParameter="Week"
                        Margin="0,0,12,0"
                        Classes.accent="{Binding IsWeekView}" />

                <!-- Month navigation -->
                <Panel Grid.Column="4" IsVisible="{Binding IsMonthView}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="◀" Command="{Binding PreviousMonthCommand}" />
                        <TextBlock Text="{Binding MonthLabel}" FontWeight="SemiBold" Width="130"
                                   TextAlignment="Center" VerticalAlignment="Center" />
                        <Button Content="▶" Command="{Binding NextMonthCommand}" />
                    </StackPanel>
                </Panel>

                <!-- Week navigation -->
                <Panel Grid.Column="4" IsVisible="{Binding IsWeekView}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="◀" Command="{Binding PreviousWeekCommand}" />
                        <TextBlock Text="{Binding WeekLabel}" FontWeight="SemiBold" Width="160"
                                   TextAlignment="Center" VerticalAlignment="Center" />
                        <Button Content="▶" Command="{Binding NextWeekCommand}" />
                    </StackPanel>
                </Panel>

                <!-- Selection info -->
                <Border Grid.Column="5" IsVisible="{Binding HasSelection}"
                        Background="#2D4A2D" CornerRadius="6" Padding="8,4" Margin="12,0,4,0">
                    <TextBlock Text="{Binding SelectionLabel}" Foreground="#81C784" FontSize="12" />
                </Border>
                <Button Grid.Column="6" Content="{Binding Loc[Clear2]}" IsVisible="{Binding HasSelection}"
                        Command="{Binding ClearSelectionCommand}" Margin="0,0,4,0" />
                <Button Grid.Column="7" Content="{Binding DeleteSelectedButtonText}"
                        IsVisible="{Binding HasSelection}"
                        Command="{Binding DeleteSelectedCommand}"
                        Foreground="#EF9A9A" Margin="0,0,4,0" />

            </Grid>
        </Border>

        <!-- Row 2: Status -->
        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="Gray" FontSize="12"
                   Margin="0,0,0,8"
                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <!-- Row 3: Calendar -->
        <Grid Grid.Row="3" RowDefinitions="Auto,Auto,*">
            <!-- Tip and weekday headers remain visible while the calendar rows scroll. -->
            <TextBlock Grid.Row="0" Text="{Binding Loc[ClickADayToOpenIt]}"
                       FontSize="11" Foreground="#666" Margin="0,0,0,8" />
            <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*,*,*" Margin="0,0,0,4">
                <TextBlock Grid.Column="0" Text="{Binding Loc[DayMonShort]}" HorizontalAlignment="Center" Foreground="#888" FontSize="12"/>
                <TextBlock Grid.Column="1" Text="{Binding Loc[DayTueShort]}" HorizontalAlignment="Center" Foreground="#888" FontSize="12"/>
                <TextBlock Grid.Column="2" Text="{Binding Loc[DayWedShort]}" HorizontalAlignment="Center" Foreground="#888" FontSize="12"/>
                <TextBlock Grid.Column="3" Text="{Binding Loc[DayThuShort]}" HorizontalAlignment="Center" Foreground="#888" FontSize="12"/>
                <TextBlock Grid.Column="4" Text="{Binding Loc[DayFriShort]}" HorizontalAlignment="Center" Foreground="#888" FontSize="12"/>
                <TextBlock Grid.Column="5" Text="{Binding Loc[DaySatShort]}" HorizontalAlignment="Center" Foreground="#777" FontSize="12"/>
                <TextBlock Grid.Column="6" Text="{Binding Loc[DaySunShort]}" HorizontalAlignment="Center" Foreground="#777" FontSize="12"/>
            </Grid>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                <!-- Calendar cells -->
                <!-- Keep exactly seven equal columns so the cells always align with the weekday header. -->
                <ItemsControl ItemsSource="{Binding Cells}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CalendarCellViewModel">
                            <Panel Height="110" Margin="2">

                                <!-- Empty filler -->
                                <Border IsVisible="{Binding !IsInMonth}" />

                                <!-- Day cell -->
                                <Border IsVisible="{Binding IsInMonth}"
                                        Tag="{Binding}"
                                        PointerPressed="OnCellPressed"
                                        CornerRadius="8" Cursor="Hand"
                                        Padding="8,6"
                                        BorderThickness="2">
                                    <Border.Background>
                                        <SolidColorBrush Color="#1A1D23" />
                                    </Border.Background>
                                    <Border.Styles>
                                        <Style Selector="Border:pointerover">
                                            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                                        </Style>
                                    </Border.Styles>
                                    <Border.BorderBrush>
                                        <SolidColorBrush Color="#3A3F4B" />
                                    </Border.BorderBrush>

                                    <StackPanel ToolTip.Tip="{Binding HolidayTooltip}">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4">
                                            <TextBlock Grid.Column="0" Text="{Binding WeekNumberText}"
                                                       IsVisible="{Binding HasWeekNumber}"
                                                       FontSize="9" Foreground="#90CAF9"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding DayNumberText}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{Binding IsToday,
                                                           Converter={x:Static vm:BoolToBackgroundConverter.Instance}}" />
                                            <TextBlock Grid.Column="2" Text="{Binding WorkTypeIcon}"
                                                       FontSize="13" />
                                        </Grid>
                                        <TextBlock Text="{Binding TimeRangeText}" FontSize="10"
                                                   Foreground="#AAAAAA" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding OvertimeText}" FontSize="10"
                                                   Foreground="#FFB74D" TextWrapping="Wrap"
                                                   IsVisible="{Binding HasOvertimeText}" />
                                        <TextBlock Text="{Binding OvertimeStatusText}" FontSize="9"
                                                   Foreground="#81C784" TextWrapping="Wrap"
                                                   IsVisible="{Binding HasOvertimeStatusText}" />
                                        <TextBlock Text="{Binding RestWarningText}" FontSize="9"
                                                   Foreground="#FF1744" FontWeight="Bold" TextWrapping="Wrap"
                                                   IsVisible="{Binding HasRestWarning}"
                                                   ToolTip.Tip="{Binding RestWarningText}" />
                                        <Border IsVisible="{Binding HasOfficialHoliday}"
                                                Background="#3A2F1B" CornerRadius="3"
                                                Padding="4,1" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding OfficialHolidayText}" FontSize="9"
                                                       Foreground="#FFD180" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                        <Border IsVisible="{Binding HasUserHoliday}"
                                                Background="#1E3545" CornerRadius="3"
                                                Padding="4,1" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding UserHolidayText}" FontSize="9"
                                                       Foreground="#90CAF9" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                        <TextBlock Text="{Binding SubmittedStatusText}" FontSize="9" Foreground="#81C784"
                                                   TextWrapping="Wrap"
                                                   IsVisible="{Binding IsSubmitted}" />
                                        <TextBlock Text="{Binding ProtocolStatusText}" FontSize="9" Foreground="#81C784"
                                                   TextWrapping="Wrap"
                                                   IsVisible="{Binding ShowSubmissionProtocol}" />
                                        <TextBlock Text="{Binding $parent[UserControl].((vm:SchedulesViewModel)DataContext).Loc[ErganiImported]}" FontSize="9" Foreground="{DynamicResource AccentLightBrush}"
                                                   IsVisible="{Binding IsErganiImported}" />
                                        <!-- Selected indicator -->
                                        <Border IsVisible="{Binding IsSelected}"
                                                Background="#1B5E20" CornerRadius="3"
                                                Padding="4,1" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding $parent[UserControl].((vm:SchedulesViewModel)DataContext).Loc[Selected]}" FontSize="9" Foreground="#81C784" />
                                        </Border>
                                    </StackPanel>

                                </Border>
                            </Panel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ── Ergani Excel import confirmation ── -->
        <Border Grid.Row="0" Grid.RowSpan="4"
                IsVisible="{Binding IsImportDialogOpen}"
                Background="#BB000000" ZIndex="80">
            <Border Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="24"
                    Width="620" MaxHeight="620"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                    <Button Content="✕" Command="{Binding CancelImportCommand}" ToolTip.Tip="Close"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-14,-14,0"
                            Padding="8,4" />
                    <TextBlock Grid.Row="0"
                               Text="{Binding Loc[ImportDeclaredScheduleFromErgani]}"
                               FontSize="18" FontWeight="Bold" />

                    <ScrollViewer Grid.Row="1">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{Binding ImportSummary}"
                                       TextWrapping="Wrap" />
                            <Border Background="#242832" CornerRadius="6" Padding="10"
                                    IsVisible="{Binding ImportWarnings, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{Binding Loc[WarningsRowsNotImported]}"
                                               FontWeight="SemiBold" Foreground="#FFCC80" />
                                    <TextBlock Text="{Binding ImportWarnings}"
                                               FontSize="11" Foreground="#BDBDBD"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding Loc[OnlyAfterYouPressImportWill]}"
                                       FontSize="12" Foreground="#90CAF9" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal"
                                HorizontalAlignment="Right" Spacing="8">
                        <Button Content="{Binding Loc[Cancel]}"
                                Command="{Binding CancelImportCommand}" />
                        <Button Content="{Binding Loc[ImportToDatabase]}"
                                Command="{Binding ConfirmImportCommand}"
                                Classes="accent" />
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- ── Import history ── -->
        <Border Grid.Row="0" Grid.RowSpan="4"
                IsVisible="{Binding IsImportHistoryOpen}"
                Background="#BB000000" ZIndex="85">
            <Border Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="24"
                    Width="680" MaxHeight="560"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                    <Button Content="✕" Command="{Binding CloseImportHistoryCommand}" ToolTip.Tip="Close"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-14,-14,0"
                            Padding="8,4" />
                    <TextBlock Grid.Row="0" Text="{Binding Loc[ErganiImportHistory]}"
                               FontSize="18" FontWeight="Bold" />
                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding ImportHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="core:ImportLogDto">
                                    <Border Background="#242832" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding PeriodText}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding CountsText}" FontSize="12" />
                                            <TextBlock FontSize="11" Foreground="#9E9E9E">
                                                <Run Text="{Binding ImportedAtText}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding DetailsText}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button Grid.Row="2" Content="{Binding Loc[Close]}" HorizontalAlignment="Right"
                            Command="{Binding CloseImportHistoryCommand}" />
                </Grid>
            </Border>
        </Border>

        <!-- ── Existing data on the imported dates: replace or keep? ── -->
        <Border Grid.Row="0" Grid.RowSpan="4"
                IsVisible="{Binding IsConflictDialogOpen}"
                Background="#BB000000" ZIndex="95">
            <Border Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="24"
                    Width="620" MaxHeight="620"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                    <Button Content="✕" Command="{Binding CancelImportCommand}" ToolTip.Tip="Close"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-14,-14,0"
                            Padding="8,4" />
                    <TextBlock Grid.Row="0" Text="{Binding Loc[ExistingDataFound]}"
                               FontSize="18" FontWeight="Bold" Foreground="#FFB74D" />
                    <ScrollViewer Grid.Row="1">
                        <TextBlock Text="{Binding ConflictText}" TextWrapping="Wrap" />
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Orientation="Horizontal"
                                HorizontalAlignment="Right" Spacing="8">
                        <Button Content="{Binding Loc[NoKeepOldData]}"
                                Command="{Binding KeepExistingCommand}" />
                        <Button Content="{Binding Loc[YesReplace]}"
                                Command="{Binding ReplaceExistingCommand}"
                                Classes="accent" />
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- ── Portal download finished: import it now? ── -->
        <Border Grid.Row="0" Grid.RowSpan="4"
                IsVisible="{Binding IsPortalImportPromptOpen}"
                Background="#BB000000" ZIndex="90">
            <Border Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="24"
                    Width="460"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Spacing="16">
                    <Button Content="✕" Command="{Binding DismissPortalImportCommand}" ToolTip.Tip="Close"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-14,-14,0"
                            Padding="8,4" />
                    <TextBlock Text="{Binding Loc[ImportFromErgani]}"
                               FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="{Binding PortalImportPromptText}"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right" Spacing="8">
                        <Button Content="{Binding Loc[No]}"
                                Command="{Binding DismissPortalImportCommand}" />
                        <Button Content="{Binding Loc[YesImport]}"
                                Command="{Binding ImportPortalFileCommand}"
                                Classes="accent" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ── Day dialog overlay ── -->
        <Border Grid.Row="0" Grid.RowSpan="4"
                IsVisible="{Binding IsDayDialogOpen}"
                Background="#BB000000" ZIndex="50">
            <Border Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="24"
                    Width="500" MaxHeight="520"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid RowDefinitions="*,Auto">
                    <Button Content="✕" Command="{Binding CloseDayDialogCommand}" ToolTip.Tip="Close"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-14,-14,0"
                            Padding="8,4" />
                    <ScrollViewer Grid.Row="0">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{Binding EditingDate, StringFormat='Schedule for {0:dd/MM/yyyy}'}"
                                       FontSize="16" FontWeight="Bold" />

                            <TextBlock Text="{Binding Loc[WorkType]}" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding AvailableWorkTypes}"
                                      SelectedItem="{Binding EditingWorkType}"
                                      HorizontalAlignment="Stretch" />

                            <StackPanel IsVisible="{Binding ShowTimeFields}" Spacing="10">
                                <TextBlock Text="{Binding Loc[Branch]}" FontWeight="SemiBold" />
                                <ComboBox ItemsSource="{Binding AvailableBranches}"
                                          SelectedItem="{Binding EditingBranch}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="{Binding Loc[ShiftSelection]}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Loc[ShiftSelectionDescription]}" Foreground="Gray" FontSize="11" TextWrapping="Wrap" />
                                <ComboBox ItemsSource="{Binding AvailableShifts}"
                                          SelectedItem="{Binding SelectedEditingShift}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <!-- The selected shift fills these values; they remain editable for this schedule. -->
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding Loc[StartTime]}" FontWeight="SemiBold" />
                                    <TimePicker SelectedTime="{Binding EditingStartTime}" ClockIdentifier="24HourClock" HorizontalAlignment="Stretch" />
                                    <TextBlock Text="{Binding Loc[EndTime]}" FontWeight="SemiBold" />
                                    <TimePicker SelectedTime="{Binding EditingEndTime}" ClockIdentifier="24HourClock" HorizontalAlignment="Stretch" />
                                    <CheckBox Content="{Binding Loc[SplitShift]}" IsChecked="{Binding EditingSplitShift}" />
                                    <StackPanel IsVisible="{Binding EditingSplitShift}" Spacing="4">
                                        <TextBlock Text="{Binding Loc[SecondPeriod]}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Loc[StartTime]}" FontSize="12" />
                                        <TimePicker SelectedTime="{Binding EditingSecondStartTime}" ClockIdentifier="24HourClock" HorizontalAlignment="Stretch" />
                                        <TextBlock Text="{Binding Loc[EndTime]}" FontSize="12" />
                                        <TimePicker SelectedTime="{Binding EditingSecondEndTime}" ClockIdentifier="24HourClock" HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding EditingTotalHours, StringFormat='Total planned hours: {0:0.##}'}" Foreground="Gray" FontSize="12" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="{Binding EditingOvertimeNote}" Foreground="#FFB74D"
                                       FontSize="12" TextWrapping="Wrap"
                                       IsVisible="{Binding EditingOvertimeNote,
                                           Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />


                            <TextBlock Text="{Binding Loc[Comments]}" FontWeight="SemiBold" />
                            <TextBox Text="{Binding EditingComments}" />

                            <TextBlock Text="{Binding EditingActualText}" Foreground="Gray" FontSize="11"
                                       IsVisible="{Binding EditingActualText,
                                           Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Text="{Binding EditingSubmissionText}" FontSize="11"
                                       Foreground="#81C784"
                                       IsVisible="{Binding EditingSubmissionText,
                                           Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                Spacing="8" Margin="0,12,0,0">
                        <Button Content="{Binding Loc[Cancel]}"
                                Command="{Binding CloseDayDialogCommand}" />
                        <Button Content="{Binding Loc[Delete2]}"
                                Command="{Binding DeleteDayCommand}"
                                IsVisible="{Binding IsEditingExisting}"
                                Foreground="#EF9A9A" />
                        <Button Content="{Binding Loc[SaveSubmit]}"
                                Command="{Binding SaveAndSubmitDayCommand}"
                                IsVisible="{Binding CanShowSubmitEditingDay}"
                                IsEnabled="{Binding CanSubmitEditingDay}"
                                ToolTip.Tip="{Binding Loc[RestSubmitBlockedTooltip]}" />
                        <Button Content="{Binding Loc[Save]}"
                                Command="{Binding SaveDayCommand}" Classes="accent" />
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- ── Bulk apply dialog overlay ── -->
        <Border Grid.Row="0" Grid.RowSpan="4"
                IsVisible="{Binding IsBulkDialogOpen}"
                Background="#BB000000" ZIndex="50">
            <Border Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="24"
                    Width="420" MaxHeight="620"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding Loc[BulkApplySchedule]}"
                                   FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="✕" Command="{Binding CloseBulkDialogCommand}"
                                ToolTip.Tip="Close" Padding="8,4" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding SelectionLabel}" FontSize="12" Foreground="Gray" />

                        <TextBlock Text="{Binding Loc[WorkType]}" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding AvailableWorkTypes}"
                                  SelectedItem="{Binding BulkWorkType}"
                                  HorizontalAlignment="Stretch" />

                        <StackPanel IsVisible="{Binding BulkShowTimeFields}" Spacing="10">
                            <TextBlock Text="{Binding Loc[Branch]}" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding AvailableBranches}"
                                      SelectedItem="{Binding EditingBranch}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{Binding Loc[ShiftSelection]}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Loc[ShiftSelectionDescription]}" Foreground="Gray" FontSize="11" TextWrapping="Wrap" />
                            <ComboBox ItemsSource="{Binding AvailableShifts}"
                                      SelectedItem="{Binding SelectedBulkShift}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <!-- The selected shift fills these values; they remain editable for this bulk operation. -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding Loc[StartTime]}" FontWeight="SemiBold" />
                                <TimePicker SelectedTime="{Binding BulkStartTime}" ClockIdentifier="24HourClock" HorizontalAlignment="Stretch" />
                                <TextBlock Text="{Binding Loc[EndTime]}" FontWeight="SemiBold" />
                                <TimePicker SelectedTime="{Binding BulkEndTime}" ClockIdentifier="24HourClock" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Day of week checkboxes — only shown when no specific days selected -->
                        <StackPanel IsVisible="{Binding !HasSelection}" Spacing="6">
                            <TextBlock Text="{Binding Loc[ApplyToDays]}" FontWeight="SemiBold" />
                            <WrapPanel Orientation="Horizontal">
                                <CheckBox Content="{Binding Loc[DayMonShort]}" IsChecked="{Binding BulkMonday}" Margin="0,0,12,4" />
                                <CheckBox Content="{Binding Loc[DayTueShort]}" IsChecked="{Binding BulkTuesday}" Margin="0,0,12,4" />
                                <CheckBox Content="{Binding Loc[DayWedShort]}" IsChecked="{Binding BulkWednesday}" Margin="0,0,12,4" />
                                <CheckBox Content="{Binding Loc[DayThuShort]}" IsChecked="{Binding BulkThursday}" Margin="0,0,12,4" />
                                <CheckBox Content="{Binding Loc[DayFriShort]}" IsChecked="{Binding BulkFriday}" Margin="0,0,12,4" />
                                <CheckBox Content="{Binding Loc[DaySatShort]}" IsChecked="{Binding BulkSaturday}" Margin="0,0,12,4" />
                                <CheckBox Content="{Binding Loc[DaySunShort]}" IsChecked="{Binding BulkSunday}" Margin="0,0,12,4" />
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="2" ColumnDefinitions="*,*" Margin="0,12,0,0" ColumnSpacing="8">
                        <Button Grid.Column="0" Content="{Binding Loc[Cancel]}"
                                Command="{Binding CloseBulkDialogCommand}"
                                HorizontalAlignment="Stretch" />
                        <Button Grid.Column="1" Content="{Binding Loc[Apply]}"
                                Command="{Binding ApplyBulkCommand}" Classes="accent"
                                HorizontalAlignment="Stretch" />
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- ── Clone dialog overlay ── -->
        <Border Grid.Row="0" Grid.RowSpan="4"
                IsVisible="{Binding IsCloneDialogOpen}"
                Background="#BB000000" ZIndex="50">
            <Border Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="24"
                    Width="460" Height="620"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                    <Button Content="✕" Command="{Binding CloseCloneDialogCommand}" ToolTip.Tip="Close"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-14,-14,0"
                            Padding="8,4" />
                    <TextBlock Grid.Row="0" Text="{Binding Loc[CloneScheduleToEmployees]}"
                               FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
                    <StackPanel Grid.Row="1" Spacing="4" Margin="0,0,0,10">
                        <TextBlock FontSize="12" Foreground="Gray" TextWrapping="Wrap">
                            <Run Text="{Binding Loc[CloneCopyingScheduleOf]}" />
                            <Run Text="{Binding SelectedEmployee.FullName}" FontWeight="SemiBold" />
                        </TextBlock>
                        <Border Background="{DynamicResource HoverBrush}" CornerRadius="6" Padding="10">
                            <TextBlock Text="{Binding CloneScopeDescription}" TextWrapping="Wrap" FontSize="12" />
                        </Border>
                        <TextBlock Text="{Binding Loc[CloneConfirmOverwriteWarning]}" FontSize="11" Foreground="Orange" TextWrapping="Wrap" />
                        <CheckBox Content="{Binding Loc[CloneIncludeHolidays]}" IsChecked="{Binding CloneIncludeHolidays}" />
                        <TextBlock Text="{Binding CloneImpactInfoText}" IsVisible="{Binding HasCloneImpactInfo}"
                                   FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CloneImpactDangerText}" IsVisible="{Binding HasCloneImpactDanger}"
                                   FontSize="12" FontWeight="SemiBold" Foreground="OrangeRed" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Loc[CloneUndoHint]}" FontSize="11" Foreground="Gray" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="{Binding Loc[SelectEmployeesToCopyTo]}"
                               FontWeight="SemiBold" Margin="0,0,0,8" />

                    <Grid Grid.Row="3" RowDefinitions="Auto,*" RowSpacing="8">
                        <TextBox Grid.Row="0" Text="{Binding CloneTargetSearch, Mode=TwoWay}"
                                 PlaceholderText="Type an employee name to search"
                                 HorizontalAlignment="Stretch" />
                        <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding FilteredCloneTargets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CloneTargetEmployee">
                                    <Border Background="{DynamicResource HoverBrush}" CornerRadius="6" Padding="12,8">
                                        <CheckBox IsChecked="{Binding IsSelected}"
                                                  Content="{Binding Name}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <Grid Grid.Row="4" ColumnDefinitions="*,*" Margin="0,12,0,0" ColumnSpacing="8">
                        <Button Grid.Column="0" Content="{Binding Loc[Cancel]}"
                                Command="{Binding CloseCloneDialogCommand}"
                                HorizontalAlignment="Stretch" />
                        <Button Grid.Column="1" Content="{Binding Loc[CopySchedule]}"
                                Command="{Binding ApplyCloneCommand}" Classes="accent"
                                HorizontalAlignment="Stretch" />
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- ── Undo last clone dialog overlay ── -->
        <Border Grid.Row="0" Grid.RowSpan="4"
                IsVisible="{Binding IsUndoCloneDialogOpen}"
                Background="#BB000000" ZIndex="50">
            <Border Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="24"
                    Width="500" MaxHeight="620"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="10">
                    <Button Content="✕" Command="{Binding CloseUndoCloneDialogCommand}" ToolTip.Tip="Close"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-14,-14,0"
                            Padding="8,4" />
                    <TextBlock Grid.Row="0" Text="{Binding Loc[UndoLastClone]}"
                               FontSize="16" FontWeight="Bold" />

                    <Border Grid.Row="1" Background="{DynamicResource HoverBrush}" CornerRadius="6" Padding="10">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding UndoCloneSummary}" TextWrapping="Wrap"
                                       FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding UndoCloneScope}" TextWrapping="Wrap"
                                       FontSize="12" Foreground="Gray" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding UndoCloneEffect}" TextWrapping="Wrap" FontSize="12"
                                       IsVisible="{Binding !UndoCloneBlocked}" />
                            <TextBlock Text="{Binding Loc[UndoCloneManualChangesNote]}" TextWrapping="Wrap"
                                       FontSize="11" Foreground="Orange"
                                       IsVisible="{Binding !UndoCloneBlocked}" />
                            <TextBlock Text="{Binding UndoCloneBlockedText}" TextWrapping="Wrap"
                                       FontSize="12" FontWeight="SemiBold" Foreground="OrangeRed"
                                       IsVisible="{Binding UndoCloneBlocked}" />
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="3" Spacing="6">
                        <TextBlock Text="{Binding Loc[CloneHistory]}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Loc[NoCloneHistory]}" FontSize="12" Foreground="Gray"
                                   IsVisible="{Binding !HasCloneHistory}" />
                        <ScrollViewer MaxHeight="170" IsVisible="{Binding HasCloneHistory}">
                            <ItemsControl ItemsSource="{Binding CloneHistory}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CloneHistoryRow">
                                        <Border Background="{DynamicResource HoverBrush}" CornerRadius="6" Padding="10,6">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                <TextBlock Grid.Column="0" Text="{Binding StatusIcon}" VerticalAlignment="Top" />
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Text="{Binding Title}" FontSize="12" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="Gray" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <Grid Grid.Row="4" ColumnDefinitions="*,*" Margin="0,4,0,0" ColumnSpacing="8">
                        <Button Grid.Column="0" Content="{Binding Loc[Close]}"
                                Command="{Binding CloseUndoCloneDialogCommand}"
                                HorizontalAlignment="Stretch" />
                        <Button Grid.Column="1" Content="{Binding Loc[UndoCloneConfirm]}"
                                Command="{Binding ConfirmUndoCloneCommand}" Classes="accent"
                                IsVisible="{Binding !UndoCloneBlocked}"
                                HorizontalAlignment="Stretch" />
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- ── Holidays form ── -->
        <Panel Grid.Row="0" Grid.RowSpan="4" ZIndex="45" IsVisible="{Binding Holidays.IsOpen}">
            <views:HolidayDialogView DataContext="{Binding Holidays}" />
        </Panel>

        <!-- ── Submission log dialog (Ergani responses + PDF) ── -->
        <Border Grid.Row="0" Grid.RowSpan="4"
                IsVisible="{Binding IsLogOpen}"
                Background="#BB000000" ZIndex="50">
            <Border Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="20"
                    Width="900" Height="560"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="10">
                    <Button Content="✕" Command="{Binding CloseLogCommand}" ToolTip.Tip="Close"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-14,-14,0"
                            Padding="8,4" />
                    <TextBlock Grid.Row="0" Text="{Binding LogTitle}" FontSize="17" FontWeight="Bold" />

                    <Panel Grid.Row="1">
                        <TextBlock Text="{Binding LogEmptyText}"
                                   Foreground="Gray" IsVisible="{Binding !HasLogRows}" />
                        <ScrollViewer IsVisible="{Binding HasLogRows}">
                            <ItemsControl ItemsSource="{Binding LogRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ScheduleLogRow">
                                        <Border Background="{DynamicResource HoverBrush}" CornerRadius="6"
                                                Padding="10,8" Margin="0,0,0,4">
                                            <Grid ColumnDefinitions="Auto,100,150,*,Auto,Auto" ColumnSpacing="10">
                                                <TextBlock Grid.Column="0" Text="{Binding StatusIcon}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding ScheduleDateText}"
                                                           FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding SubmittedAtText}"
                                                           Foreground="#AAAAAA" FontSize="12"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{Binding Summary}"
                                                           TextWrapping="Wrap" VerticalAlignment="Center" />
                                                <Button Grid.Column="4" Content="{Binding $parent[UserControl].((vm:SchedulesViewModel)DataContext).Loc[ResponseLabel]}"
                                                        Tag="{Binding}" Click="OnLogResponseClick" />
                                                <Button Grid.Column="5" Content="{Binding $parent[UserControl].((vm:SchedulesViewModel)DataContext).Loc[PdfLabel]}"
                                                        Tag="{Binding}" Click="OnLogPdfClick"
                                                        IsEnabled="{Binding HasProtocol}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Panel>

                    <TextBlock Grid.Row="2" Text="{Binding LogStatus}" Foreground="Gray" FontSize="12"
                               IsVisible="{Binding LogStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <Button Grid.Row="3" Content="{Binding Loc[Close]}" Command="{Binding CloseLogCommand}"
                            HorizontalAlignment="Right" Width="100" />
                </Grid>
            </Border>
        </Border>

        <!-- ── Raw Ergani response ── -->
        <Border Grid.Row="0" Grid.RowSpan="4"
                IsVisible="{Binding IsResponseOpen}"
                Background="#AA000000" ZIndex="60">
            <Border Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="20"
                    Width="800" Height="560"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                    <Button Content="✕" Command="{Binding CloseResponseCommand}" ToolTip.Tip="Close"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-14,-14,0"
                            Padding="8,4" />
                    <TextBlock Grid.Row="0" Text="{Binding ResponseTitle}" FontSize="17" FontWeight="Bold" />
                    <TextBox Grid.Row="1" Text="{Binding ResponseText}" IsReadOnly="True"
                             AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas"
                             ScrollViewer.VerticalScrollBarVisibility="{x:Static ScrollBarVisibility.Auto}"
                             ScrollViewer.HorizontalScrollBarVisibility="{x:Static ScrollBarVisibility.Auto}" />
                    <Button Grid.Row="2" Content="{Binding Loc[Close]}" Command="{Binding CloseResponseCommand}"
                            HorizontalAlignment="Right" Width="100" />
                </Grid>
            </Border>
        </Border>

        <!-- ── Confirm company-wide pending schedule submission ── -->
        <Border Grid.Row="0" Grid.RowSpan="4"
                IsVisible="{Binding IsBulkSubmitDialogOpen}"
                Background="#BB000000" ZIndex="65">
            <Border Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="24"
                    Width="520" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Spacing="16">
                    <Button Content="✕" Command="{Binding CancelBulkSubmitSchedulesCommand}" ToolTip.Tip="Close"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-14,-14,0"
                            Padding="8,4" />
                    <TextBlock Text="{Binding Loc[ConfirmBulkScheduleSubmission]}" FontSize="16" FontWeight="Bold" />
                    <TextBlock Text="{Binding BulkSubmitSummary}" TextWrapping="Wrap" />
                    <Button Content="{Binding Loc[ViewEmployeeDetails]}"
                            Command="{Binding ShowBulkSubmitDetailsCommand}"
                            HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding Loc[BulkSubmissionSafetyNote]}" TextWrapping="Wrap" Foreground="Gray" FontSize="12" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Content="{Binding Loc[Cancel]}" Command="{Binding CancelBulkSubmitSchedulesCommand}" />
                        <Button Content="{Binding Loc[SubmitAllPendingSchedules]}" Command="{Binding ConfirmSubmitAllPendingSchedulesCommand}"
                                Classes="accent" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Detailed employee list for the pending bulk submission. -->
        <Border Grid.Row="0" Grid.RowSpan="4"
                IsVisible="{Binding IsBulkSubmitDetailsOpen}"
                Background="#CC000000" ZIndex="75">
            <Border Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="20"
                    Width="760" MaxWidth="950" Height="620" MaxHeight="700"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding BulkSubmitDetailsTitle}" FontSize="17" FontWeight="Bold"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="✕" Command="{Binding CloseBulkSubmitDetailsCommand}"
                                ToolTip.Tip="Close" />
                    </Grid>
                    <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="6">
                        <Grid ColumnDefinitions="2*,110,1.5*,1.5*" Margin="6,0" ColumnSpacing="8">
                            <TextBlock Text="{Binding Loc[Employees]}" FontWeight="Bold" />
                            <TextBlock Grid.Column="1" Text="{Binding Loc[Date]}" FontWeight="Bold" />
                            <TextBlock Grid.Column="2" Text="From" FontWeight="Bold" />
                            <TextBlock Grid.Column="3" Text="To" FontWeight="Bold" />
                        </Grid>
                        <ScrollViewer Grid.Row="1" MaxHeight="470"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding BulkSubmitDetails}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:CompileBindings="False">
                                        <Border Background="{DynamicResource CardBrush}" CornerRadius="5"
                                                Padding="8,6" Margin="0,0,0,4">
                                            <Grid ColumnDefinitions="2*,110,1.5*,1.5*" ColumnSpacing="8">
                                                <TextBlock Text="{Binding EmployeeName}" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="1" Text="{Binding DateText}" />
                                                <TextBlock Grid.Column="2" Text="{Binding FromDetails}" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="3" Text="{Binding ToDetails}" TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                    <Button Grid.Row="2" Content="{Binding Loc[Close]}"
                            Command="{Binding CloseBulkSubmitDetailsCommand}"
                            HorizontalAlignment="Right" Width="100" />
                </Grid>
            </Border>
        </Border>

        <!-- ── Delete confirmation ── -->
        <Border Grid.Row="0" Grid.RowSpan="4"
                IsVisible="{Binding IsConfirmDeleteOpen}"
                Background="#BB000000" ZIndex="70">
            <Border Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="24"
                    Width="440" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Spacing="16">
                    <Button Content="✕" Command="{Binding CancelDeleteCommand}" ToolTip.Tip="Close"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-14,-14,0"
                            Padding="8,4" />
                    <TextBlock Text="{Binding Loc[DeleteSchedule]}" FontSize="16" FontWeight="Bold" />
                    <TextBlock Text="{Binding ConfirmDeleteMessage}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Content="{Binding Loc[Cancel]}" Command="{Binding CancelDeleteCommand}" />
                        <Button Content="{Binding Loc[Delete]}" Command="{Binding ConfirmDeleteCommand}"
                                Foreground="#EF9A9A" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

    </Grid>

</UserControl>
