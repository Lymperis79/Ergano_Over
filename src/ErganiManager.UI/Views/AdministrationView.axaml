<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ErganiManager.UI.ViewModels"
             x:Class="ErganiManager.UI.Views.AdministrationView"
             x:DataType="vm:AdministrationViewModel">

    <Grid>
        <ScrollViewer>
            <StackPanel Spacing="16" MaxWidth="820" HorizontalAlignment="Left">
                <TextBlock Text="{Binding FormTitle}" FontSize="22" FontWeight="Bold" />

                <TabControl>
                    <TabItem Header="{Binding Loc[AdminGeneralSettings]}" IsVisible="{Binding IsDatabaseOptionsView}">
                        <StackPanel Spacing="16" Margin="0,12,0,0">
                            <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="20">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{Binding Loc[AdminDatabaseSettings]}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding DatabaseInfo}" Foreground="Gray" TextWrapping="Wrap" />
                                    <Button Content="{Binding Loc[AdminBackup]}" Click="OnBackupClick" IsEnabled="{Binding !IsBusy}" />
                                    <TextBlock Text="{Binding LastBackupInfo}" Foreground="Gray" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="20">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{Binding Loc[AutomaticBackupTitle]}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Loc[AutomaticBackupNote]}" Foreground="Gray" FontSize="12" TextWrapping="Wrap" />
                                    <CheckBox Content="{Binding Loc[AutomaticBackupEnabled]}" IsChecked="{Binding AutomaticBackupEnabled}" />
                                    <TextBlock Text="{Binding Loc[AutomaticBackupInterval]}" />
                                    <NumericUpDown Value="{Binding AutomaticBackupIntervalHours}" Minimum="1" Maximum="168" Increment="1" />
                                    <TextBlock Text="{Binding Loc[AutomaticBackupRetention]}" />
                                    <NumericUpDown Value="{Binding AutomaticBackupRetentionCount}" Minimum="1" Maximum="100" Increment="1" />
                                    <TextBlock Text="{Binding Loc[AutomaticBackupFolder]}" />
                                    <TextBox Text="{Binding AutomaticBackupFolder, Mode=TwoWay}" />
                                    <Button Content="{Binding Loc[SaveAutomaticBackupSettings]}" Command="{Binding SaveAutomaticBackupSettingsCommand}" IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Left" />
                                    <TextBlock Text="{Binding Loc[AutomaticBackupLastSuccess]}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding AutomaticBackupLastSuccess}" Foreground="Gray" />
                                    <TextBlock Text="{Binding Loc[AutomaticBackupNextRun]}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding AutomaticBackupNextRun}" Foreground="Gray" />
                                    <TextBlock Text="{Binding Loc[AutomaticBackupStatus]}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding AutomaticBackupStatus}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="20">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{Binding Loc[AdminLocalCache]}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding CacheInfo}" Foreground="Gray" TextWrapping="Wrap" />
                                    <Button Content="{Binding Loc[AdminDeleteCache]}" Command="{Binding AskDeleteCacheCommand}" IsEnabled="{Binding !IsBusy}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>



                    <TabItem Header="{Binding Loc[SystemHealth]}" IsVisible="{Binding !IsDatabaseOptionsView}">
                        <StackPanel Spacing="12" Margin="0,12,0,0">
                            <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="20">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{Binding SystemHealthSummary}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Loc[HealthDashboardDescription]}" Foreground="Gray" FontSize="12" TextWrapping="Wrap" />
                                    <Button Content="{Binding Loc[RefreshHealth]}" Command="{Binding RefreshSystemHealthCommand}" IsEnabled="{Binding !IsRefreshingSystemHealth}" HorizontalAlignment="Left" />
                                    <TextBlock Text="{Binding HealthLastChecked}" Foreground="Gray" FontSize="11" />
                                </StackPanel>
                            </Border>
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                                <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="16">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{Binding Loc[HealthDatabase]}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding DatabaseHealthStatus}" FontSize="15" />
                                        <TextBlock Text="{Binding DatabaseHealthDetail}" Foreground="Gray" FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="16">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{Binding Loc[HealthInternet]}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding InternetHealthStatus}" FontSize="15" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="16">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{Binding Loc[HealthErganiEndpoint]}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ErganiHealthStatus}" FontSize="13" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Loc[HealthEndpointDisclaimer]}" Foreground="Gray" FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="16">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{Binding Loc[HealthEmail]}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding EmailHealthStatus}" FontSize="13" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="0" Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="16">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{Binding Loc[HealthLocalCache]}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding CacheHealthStatus}" FontSize="13" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Loc[HealthQueuedScans]}" FontSize="12" />
                                        <TextBlock Text="{Binding QueuedScansHealthStatus}" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Loc[HealthLastSuccessfulSync]}" FontSize="12" />
                                        <TextBlock Text="{Binding LastSuccessfulSyncHealthStatus}" FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="1" Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="16">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{Binding Loc[HealthFailedSubmissions]}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding FailedSubmissionsHealthStatus}" FontSize="24" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Loc[HealthFailedSubmissionsHint]}" Foreground="Gray" FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="{Binding Loc[CompanySettings]}" IsVisible="{Binding !IsDatabaseOptionsView}">
                        <StackPanel Spacing="16" Margin="0,12,0,0">
                            <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="20">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{Binding Loc[CompanySettings]}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Loc[CompanySettingsUsesMainSelector]}" Foreground="Gray" FontSize="12" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding CompanySettingsStatus}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Loc[ErganiBaseUrl]}" FontWeight="SemiBold" />
                                    <TextBox Text="{Binding CompanyErganiBaseUrl, Mode=TwoWay}" />
                                    <Separator />
                                    <TextBlock Text="{Binding Loc[TimeRules]}" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Loc[EarlyClockInBlock]}" FontWeight="SemiBold" />
                                    <NumericUpDown Value="{Binding EarlyClockInBlockMinutes}" Minimum="0" Maximum="120" />
                                    <TextBlock Text="{Binding Loc[EarlyDepartureAlert]}" FontWeight="SemiBold" />
                                    <NumericUpDown Value="{Binding EarlyDepartureAlertMinutes}" Minimum="0" Maximum="120" />
                                    <CheckBox Content="{Binding Loc[BlockRestAbsent]}" IsChecked="{Binding BlockClockInOnRestOrAbsentDay}" />
                                    <CheckBox Content="{Binding Loc[BlockNoSchedule]}" IsChecked="{Binding BlockClockInWithoutSchedule}" />
                                    <Separator />
                                    <TextBlock Text="{Binding Loc[EmailAlerts]}" FontSize="15" FontWeight="SemiBold" />
                                    <CheckBox Content="{Binding Loc[EmailAlerts]}" IsChecked="{Binding AlertEmailEnabled}" />
                                    <StackPanel IsVisible="{Binding AlertEmailEnabled}" Spacing="10">
                                        <TextBlock Text="{Binding Loc[AlertEmailRecipientsCommaSeparated]}" FontWeight="SemiBold" />
                                        <TextBox Text="{Binding AlertEmailRecipients}" />
                                        <TextBlock Text="{Binding Loc[SMTPHost]}" FontWeight="SemiBold" />
                                        <TextBox Text="{Binding SmtpHost}" PlaceholderText="smtp.example.com" />
                                        <TextBlock Text="{Binding Loc[SMTPPort]}" FontWeight="SemiBold" />
                                        <NumericUpDown Value="{Binding SmtpPort}" Minimum="1" Maximum="65535" />
                                        <TextBlock Text="{Binding Loc[SMTPUsername]}" FontWeight="SemiBold" />
                                        <TextBox Text="{Binding SmtpUser}" />
                                        <TextBlock Text="{Binding Loc[SMTPPassword]}" FontWeight="SemiBold" />
                                        <TextBox Text="{Binding SmtpPassword}" PasswordChar="•" />
                                        <CheckBox Content="{Binding Loc[UseTLS]}" IsChecked="{Binding SmtpUseTls}" />
                                        <Button Content="{Binding Loc[TestEmailSettings]}" Command="{Binding TestCompanyEmailCommand}" IsEnabled="{Binding !IsTestingCompanyEmail}" HorizontalAlignment="Left" />
                                        <Border IsVisible="{Binding CompanyEmailTestResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" CornerRadius="4" Padding="8,6">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding CompanyEmailTestSuccess, Converter={x:Static vm:BoolToBackgroundConverter.Instance}}" />
                                            </Border.Background>
                                            <TextBlock Text="{Binding CompanyEmailTestResult}" Foreground="White" FontSize="12" TextWrapping="Wrap" />
                                        </Border>
                                        <Separator />
                                        <TextBlock Text="{Binding Loc[AlertEventsTitle]}" FontWeight="SemiBold" />
                                        <CheckBox Content="{Binding Loc[AlertEvEarlyDeparture]}" IsChecked="{Binding AlertEvEarlyDeparture}" />
                                        <CheckBox Content="{Binding Loc[AlertEvErganiDown]}" IsChecked="{Binding AlertEvErganiDown}" />
                                        <CheckBox Content="{Binding Loc[AlertEvInternetDown]}" IsChecked="{Binding AlertEvInternetDown}" />
                                        <CheckBox Content="{Binding Loc[AlertEvEarlyClockIn]}" IsChecked="{Binding AlertEvEarlyClockIn}" />
                                        <CheckBox Content="{Binding Loc[AlertEvLateClockIn]}" IsChecked="{Binding AlertEvLateClockIn}" />
                                        <CheckBox Content="{Binding Loc[AlertEvNoSchedule]}" IsChecked="{Binding AlertEvNoSchedule}" />
                                        <CheckBox Content="{Binding Loc[AlertEvScanRejected]}" IsChecked="{Binding AlertEvScanRejected}" />
                                        <CheckBox Content="{Binding Loc[AlertEvAutomaticClockOut]}" IsChecked="{Binding AlertEvAutomaticClockOut}" />
                                        <TextBlock Text="{Binding Loc[ClockInAlertMinutes]}" FontWeight="SemiBold" />
                                        <NumericUpDown Value="{Binding ClockInAlertMinutes}" Minimum="0" Maximum="240" />
                                        <TextBlock Text="{Binding Loc[AlertEventsHint]}" TextWrapping="Wrap" Foreground="Gray" FontSize="11" />
                                    </StackPanel>
                                    <Separator />
                                    <TextBlock Text="{Binding Loc[AutoRetry]}" FontSize="15" FontWeight="SemiBold" />
                                    <CheckBox Content="{Binding Loc[AutoRetry]}" IsChecked="{Binding AutoRetryFailedSubmissions}" />
                                    <TextBlock Text="{Binding Loc[AutoRetryDesc]}" TextWrapping="Wrap" Foreground="Gray" FontSize="11" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="{Binding Loc[Save]}" Command="{Binding SaveCompanySettingsCommand}" Classes="accent" />
                                        <Button Content="{Binding Loc[DiscardChanges]}" Command="{Binding DiscardCompanySettingsCommand}" IsEnabled="{Binding IsCompanySettingsDirty}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="{Binding Loc[OfficialHolidays]}" IsVisible="{Binding !IsDatabaseOptionsView}">
                        <StackPanel Spacing="12" Margin="0,12,0,0">
                            <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="20">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{Binding Loc[OfficialHolidaysTitle]}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Loc[OfficialHolidaysDescription]}" Foreground="Gray" FontSize="12" TextWrapping="Wrap" />
                                    <Button Content="{Binding Loc[OfficialHolidaysSynchronize]}" Command="{Binding SynchronizeOfficialHolidaysCommand}" HorizontalAlignment="Left" />
                                    <TextBlock Text="{Binding OfficialHolidaysStatus}" TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding OfficialHolidays}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:OfficialHolidayEdit">
                                                <Grid ColumnDefinitions="Auto,130,*" ColumnSpacing="12">
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding DateLabel}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding Loc[OfficialHolidaysEffect]}" Foreground="Gray" FontSize="12" TextWrapping="Wrap" />
                                    <Separator />
                                    <TextBlock Text="{Binding Loc[OfficialHolidayAddCustomTitle]}" FontWeight="SemiBold" />
                                    <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                                        <StackPanel Grid.Row="0" Spacing="4">
                                            <TextBlock Text="{Binding Loc[Date]}" Foreground="Gray" FontSize="11" />
                                            <DatePicker SelectedDate="{Binding NewOfficialHolidayDate, Mode=TwoWay}"
                                                        HorizontalAlignment="Stretch" MinWidth="0" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Spacing="4">
                                            <TextBlock Text="{Binding Loc[OfficialHolidayNamePlaceholder]}" Foreground="Gray" FontSize="11" />
                                            <TextBox Text="{Binding NewOfficialHolidayName, Mode=TwoWay}"
                                                     PlaceholderText="{Binding Loc[OfficialHolidayNamePlaceholder]}"
                                                     HorizontalAlignment="Stretch" MinWidth="0" />
                                        </StackPanel>
                                    </Grid>
                                    <Button Content="{Binding Loc[OfficialHolidayAddCustom]}" Command="{Binding AddCustomOfficialHolidayCommand}" HorizontalAlignment="Left" />
                                    <Button Content="{Binding Loc[Save]}" Command="{Binding SaveOfficialHolidaysCommand}" Classes="accent" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="{Binding Loc[AdminHoursSettings]}" IsVisible="{Binding !IsDatabaseOptionsView}">
                        <StackPanel Spacing="16" Margin="0,12,0,0">
                            <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="20">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{Binding Loc[AdminShifts]}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Loc[AdminShiftsDescription]}" Foreground="Gray" FontSize="12" TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="*,200,200" ColumnSpacing="12">
                                        <TextBlock Grid.Column="0" Text="{Binding Loc[ShiftName]}" Foreground="Gray" FontSize="11" />
                                        <TextBlock Grid.Column="1" Text="{Binding Loc[ShiftStart]}" Foreground="Gray" FontSize="11" />
                                        <TextBlock Grid.Column="2" Text="{Binding Loc[ShiftEnd]}" Foreground="Gray" FontSize="11" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Shifts}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ShiftEdit">
                                                <Grid ColumnDefinitions="*,200,200" ColumnSpacing="12">
                                                    <TextBox Grid.Column="0" Text="{Binding Name}" />
                                                    <TimePicker Grid.Column="1" SelectedTime="{Binding StartTime}" ClockIdentifier="24HourClock" HorizontalAlignment="Stretch" MinWidth="0" />
                                                    <TimePicker Grid.Column="2" SelectedTime="{Binding EndTime}" ClockIdentifier="24HourClock" HorizontalAlignment="Stretch" MinWidth="0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding RoundingStatus}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="20">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{Binding Loc[WorkingTimeRounding]}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="12"
                                               Text="{Binding Loc[UsedByTheRoundedColumnOf]}" />
                                    <Grid ColumnDefinitions="110,110,130,*" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0" Text="{Binding Loc[FromMinute]}" Foreground="Gray" FontSize="11" />
                                        <TextBlock Grid.Column="1" Text="{Binding Loc[ToMinute]}" Foreground="Gray" FontSize="11" />
                                        <TextBlock Grid.Column="2" Text="{Binding Loc[RoundToMin]}" Foreground="Gray" FontSize="11" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding RoundingBands}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:RoundingBandEdit">
                                                <Grid ColumnDefinitions="110,110,130,*" ColumnSpacing="8">
                                                    <NumericUpDown Grid.Column="0" Value="{Binding From}" Minimum="0" Maximum="59" Increment="1" FormatString="0" />
                                                    <NumericUpDown Grid.Column="1" Value="{Binding To}" Minimum="0" Maximum="59" Increment="1" FormatString="0" />
                                                    <NumericUpDown Grid.Column="2" Value="{Binding RoundTo}" Minimum="0" Maximum="60" Increment="15" FormatString="0" />
                                                    <Button Grid.Column="3" Content="✕" HorizontalAlignment="Left"
                                                            Command="{Binding $parent[ItemsControl].((vm:AdministrationViewModel)DataContext).RemoveRoundingBandCommand}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="{Binding Loc[AddRange]}" Command="{Binding AddRoundingBandCommand}" />
                                        <Button Content="{Binding Loc[RestoreDefaults]}" Command="{Binding RestoreRoundingDefaultsCommand}" />
                                        <Button Content="{Binding Loc[Save]}" Command="{Binding SaveRoundingCommand}" Classes="accent" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="20">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{Binding Loc[NightWorkingHours]}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Loc[NightWorkingHoursDescription]}" Foreground="Gray" FontSize="12" TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="{Binding Loc[NightStart]}" Foreground="Gray" FontSize="11" />
                                            <TimePicker SelectedTime="{Binding NightStartTime}" ClockIdentifier="24HourClock" MinuteIncrement="1" HorizontalAlignment="Stretch" MinWidth="0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="{Binding Loc[NightEnd]}" Foreground="Gray" FontSize="11" />
                                            <TimePicker SelectedTime="{Binding NightEndTime}" ClockIdentifier="24HourClock" MinuteIncrement="1" HorizontalAlignment="Stretch" MinWidth="0" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding NightStatus}" TextWrapping="Wrap" />
                                    <Button Content="{Binding Loc[Save]}" Command="{Binding SaveNightHoursCommand}" Classes="accent" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="20">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{Binding Loc[OnTimeWindowTitle]}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Loc[OnTimeWindowDescription]}" Foreground="Gray" FontSize="12" TextWrapping="Wrap" />
                                    <StackPanel Spacing="4" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Loc[OnTimeWindowMinutesLabel]}" Foreground="Gray" FontSize="11" />
                                        <NumericUpDown Value="{Binding OnTimeWindowMinutes}" Minimum="0" Maximum="1440" Increment="1" FormatString="0" MinWidth="160" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding OnTimeWindowStatus}" TextWrapping="Wrap" />
                                    <Button Content="{Binding Loc[Save]}" Command="{Binding SaveOnTimeWindowCommand}" Classes="accent" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="20">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{Binding Loc[AutoClockOutTitle]}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Loc[AutoClockOutDescription]}" Foreground="Gray" FontSize="12" TextWrapping="Wrap" />
                                    <CheckBox IsChecked="{Binding AutoClockOutEnabled}" Content="{Binding Loc[AutoClockOutEnabledLabel]}" />
                                    <StackPanel Spacing="4" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Loc[AutoClockOutMinutesLabel]}" Foreground="Gray" FontSize="11" />
                                        <NumericUpDown Value="{Binding AutoClockOutMinutes}" Minimum="0" Maximum="1440" Increment="1" FormatString="0" MinWidth="160" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding AutoClockOutStatus}" TextWrapping="Wrap" />
                                    <Button Content="{Binding Loc[Save]}" Command="{Binding SaveAutoClockOutCommand}" Classes="accent" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="{Binding Loc[AdminPortalSettings]}" IsVisible="{Binding !IsDatabaseOptionsView}">
                        <StackPanel Spacing="16" Margin="0,12,0,0">
                            <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="20">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{Binding Loc[SchedulePortal]}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="12" Text="{Binding Loc[SchedulePortalDescription]}" />
                                    <TextBlock Text="{Binding Loc[PortalBaseAddress]}" FontWeight="SemiBold" />
                                    <TextBox Text="{Binding SchedulePortalBaseUrl}" PlaceholderText="{Binding Loc[PortalBaseAddress]}" />
                                    <TextBlock Text="{Binding Loc[PortalTargetPage]}" FontWeight="SemiBold" />
                                    <TextBox Text="{Binding SchedulePortalTargetUrl}" PlaceholderText="{Binding Loc[PortalTargetPage]}" />
                                    <TextBlock Text="{Binding Loc[PortalFromDateFieldId]}" FontWeight="SemiBold" />
                                    <TextBox Text="{Binding SchedulePortalFromField}" />
                                    <TextBlock Text="{Binding Loc[PortalToDateFieldId]}" FontWeight="SemiBold" />
                                    <TextBox Text="{Binding SchedulePortalToField}" />
                                    <TextBlock Text="{Binding Loc[PortalDateFormat]}" FontWeight="SemiBold" />
                                    <TextBox Text="{Binding SchedulePortalDateFormat}" PlaceholderText="{Binding Loc[PortalDateFormatPlaceholder]}" Width="160" HorizontalAlignment="Left" />
                                    <CheckBox IsChecked="{Binding SchedulePortalAutoSearch}" Content="{Binding Loc[PortalAutoSearch]}" />
                                    <CheckBox IsChecked="{Binding SchedulePortalAutoDownload}" Content="{Binding Loc[PortalAutoDownload]}" />
                                    <TextBlock Text="{Binding Loc[PortalSearchButtonId]}" FontWeight="SemiBold" />
                                    <TextBox Text="{Binding SchedulePortalSearchButton}" />
                                    <TextBlock Text="{Binding Loc[PortalDownloadFolder]}" FontWeight="SemiBold" />
                                    <TextBox Text="{Binding SchedulePortalDownloadFolder}" PlaceholderText="{Binding Loc[PortalDownloadFolderPlaceholder]}" />
                                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                                        <Button Content="{Binding Loc[SaveSchedulePortal]}" Command="{Binding SaveSchedulePortalCommand}" Classes="accent" />
                                        <TextBlock Text="{Binding SchedulePortalStatus}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="20">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{Binding Loc[WorkCardsPortal]}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="12" Text="{Binding Loc[WorkCardsPortalDescription]}" />
                                    <TextBlock Text="{Binding Loc[PortalBaseAddress]}" FontWeight="SemiBold" />
                                    <TextBox Text="{Binding WorkCardsPortalBaseUrl}" PlaceholderText="{Binding Loc[PortalBaseAddress]}" />
                                    <TextBlock Text="{Binding Loc[PortalTargetPage]}" FontWeight="SemiBold" />
                                    <TextBox Text="{Binding WorkCardsPortalTargetUrl}" PlaceholderText="{Binding Loc[PortalTargetPage]}" />
                                    <TextBlock Text="{Binding Loc[PortalFromDateFieldId]}" FontWeight="SemiBold" />
                                    <TextBox Text="{Binding WorkCardsPortalFromField}" />
                                    <TextBlock Text="{Binding Loc[PortalToDateFieldId]}" FontWeight="SemiBold" />
                                    <TextBox Text="{Binding WorkCardsPortalToField}" />
                                    <TextBlock Text="{Binding Loc[PortalDateFormat]}" FontWeight="SemiBold" />
                                    <TextBox Text="{Binding WorkCardsPortalDateFormat}" PlaceholderText="{Binding Loc[PortalDateFormatPlaceholder]}" Width="160" HorizontalAlignment="Left" />
                                    <CheckBox IsChecked="{Binding WorkCardsPortalAutoSearch}" Content="{Binding Loc[PortalAutoSearch]}" />
                                    <TextBlock Text="{Binding Loc[PortalSearchButtonId]}" FontWeight="SemiBold" />
                                    <TextBox Text="{Binding WorkCardsPortalSearchButton}" />
                                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                                        <Button Content="{Binding Loc[SaveWorkCardsPortal]}" Command="{Binding SaveWorkCardsPortalCommand}" Classes="accent" />
                                        <TextBlock Text="{Binding WorkCardsPortalStatus}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="{Binding Loc[AdminLeaveTypes]}" IsVisible="{Binding !IsDatabaseOptionsView}">
                        <StackPanel Spacing="12" Margin="0,12,0,0">
                            <TextBlock Text="{Binding Loc[AdminLeaveTypesDescription]}" TextWrapping="Wrap" Foreground="Gray"/>
                            <Grid ColumnDefinitions="110,*,100,180,40" ColumnSpacing="16">
                                <TextBlock Grid.Column="0" Text="{Binding Loc[LeaveTypeCode]}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="{Binding Loc[LeaveTypeDescription]}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="2" Text="{Binding Loc[LeaveTypeHourly]}" FontWeight="SemiBold" TextAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding Loc[LeaveTypePaymentCategory]}" FontWeight="SemiBold" TextAlignment="Center"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding EditableLeaveTypes}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LeaveTypeEdit">
                                        <Grid ColumnDefinitions="110,*,100,180,40" ColumnSpacing="16">
                                            <TextBox Grid.Column="0" Text="{Binding Code}" MaxLength="10"/>
                                            <TextBox Grid.Column="1" Text="{Binding Description}"/>
                                            <CheckBox Grid.Column="2" IsChecked="{Binding IsHourly}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="3" ItemsSource="{Binding $parent[UserControl].((vm:AdministrationViewModel)DataContext).LeavePaymentOptions}" SelectedItem="{Binding SelectedPaymentOption, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="0">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:LeavePaymentOption">
                                                        <TextBlock Text="{Binding Label}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Button Grid.Column="4" Background="#D32F2F" Foreground="#FFFFFF"
                                                    BorderBrush="#B71C1C" BorderThickness="1" CornerRadius="4"
                                                    Width="32" Height="30" Padding="0"
                                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Command="{Binding $parent[UserControl].((vm:AdministrationViewModel)DataContext).RemoveLeaveTypeCommand}"
                                                    CommandParameter="{Binding}" ToolTip.Tip="{Binding $parent[UserControl].((vm:AdministrationViewModel)DataContext).Loc[LeaveTypeRemove]}">
                                                <TextBlock Text="X" Foreground="#FFFFFF" FontFamily="Arial"
                                                           FontWeight="Bold" FontSize="16"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="{Binding Loc[LeaveTypeAdd]}" Command="{Binding AddLeaveTypeCommand}"/>
                                <Button Content="{Binding Loc[LeaveTypeSave]}" Command="{Binding SaveLeaveTypesCommand}" Classes="accent"/>
                                <TextBlock Text="{Binding LeaveTypesStatus}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="{Binding Loc[TerminalAnnouncements]}" IsVisible="{Binding !IsDatabaseOptionsView}">
                        <StackPanel Spacing="12" Margin="0,12,0,0">
                            <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="20">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{Binding Loc[TerminalAnnouncements]}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Loc[TerminalAnnouncementsDescription]}" Foreground="Gray" TextWrapping="Wrap" />
                                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                        <StackPanel Spacing="9">
                                            <TextBlock Text="{Binding Loc[Vm.Weather display settings]}" FontSize="15" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Loc[Vm.Select branch and choose what the terminal weather bar displays.]}" Foreground="Gray" TextWrapping="Wrap"/>
                                            <ComboBox ItemsSource="{Binding WeatherBranches}" SelectedValue="{Binding SelectedWeatherBranchId}" SelectedValueBinding="{Binding Id}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Text="{Binding BranchNumber, StringFormat='#{0}'}" />
                                                            <TextBlock Text="{Binding Name}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
                                                <CheckBox Grid.Row="0" Grid.Column="0" Content="{Binding Loc[Vm.Show temperature]}" IsChecked="{Binding WeatherShowTemperature}"/>
                                                <CheckBox Grid.Row="0" Grid.Column="1" Content="{Binding Loc[Vm.Show weather condition]}" IsChecked="{Binding WeatherShowCondition}"/>
                                                <CheckBox Grid.Row="1" Grid.Column="0" Content="{Binding Loc[Vm.Show humidity]}" IsChecked="{Binding WeatherShowHumidity}"/>
                                                <CheckBox Grid.Row="1" Grid.Column="1" Content="{Binding Loc[Vm.Show wind speed]}" IsChecked="{Binding WeatherShowWind}"/>
                                                <CheckBox Grid.Row="2" Grid.Column="0" Content="{Binding Loc[Vm.Show feels-like temperature]}" IsChecked="{Binding WeatherShowFeelsLike}"/>
                                                <CheckBox Grid.Row="2" Grid.Column="1" Content="{Binding Loc[Vm.Show location name]}" IsChecked="{Binding WeatherShowLocation}"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Loc[Vm.Manual location override (optional)]}" FontWeight="SemiBold"/>
                                            <TextBox Text="{Binding WeatherManualAddress}" PlaceholderText="{Binding Loc[Vm.Manual address, town or city]}"/>
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                <TextBox Grid.Column="0" Text="{Binding WeatherLatitude}" PlaceholderText="{Binding Loc[Vm.Latitude (optional)]}"/>
                                                <TextBox Grid.Column="1" Text="{Binding WeatherLongitude}" PlaceholderText="{Binding Loc[Vm.Longitude (optional)]}"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Loc[Vm.Coordinates take priority over the manual address. Leave both empty to use the branch address.]}" Foreground="Gray" TextWrapping="Wrap" FontSize="11"/>
                                            <TextBlock Text="{Binding Loc[Vm.Terminal preview]}" FontWeight="SemiBold"/>
                                            <Border Background="#171D27" CornerRadius="6" Padding="12">
                                                <TextBlock Text="{Binding WeatherPreviewText}" Foreground="#B8D7F5" TextWrapping="Wrap"/>
                                            </Border>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Content="{Binding Loc[Vm.Test location]}" Command="{Binding TestWeatherLocationCommand}"/>
                                                <Button Content="{Binding Loc[Vm.Save weather settings]}" Command="{Binding SaveWeatherSettingsCommand}" Classes="accent"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding WeatherSettingsStatus}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBox Text="{Binding NewTerminalAnnouncement, Mode=TwoWay}" PlaceholderText="{Binding Loc[NewAnnouncement]}" AcceptsReturn="True" MaxLength="200" MinHeight="72" TextWrapping="Wrap" />
                                    <Button Content="{Binding Loc[PublishAnnouncement]}" Command="{Binding AddTerminalAnnouncementCommand}" Classes="accent" HorizontalAlignment="Left" />
                                    <TextBlock Text="{Binding TerminalAnnouncementsStatus}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="16">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{Binding Loc[SavedAnnouncements]}" FontSize="15" FontWeight="SemiBold" />
                                    <ItemsControl ItemsSource="{Binding TerminalAnnouncements}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TerminalAnnouncementEdit">
                                                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="4,10">
                                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto,Auto">
                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Message}" TextWrapping="Wrap" />
                                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding CreatedAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Foreground="Gray" FontSize="11" />
                                                        <TextBlock Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Text="{Binding IsActive}" VerticalAlignment="Center" Margin="8,0" />
                                                        <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" Content="{Binding $parent[UserControl].((vm:AdministrationViewModel)DataContext).Loc[EnableDisableAnnouncement]}" Command="{Binding $parent[UserControl].((vm:AdministrationViewModel)DataContext).ToggleTerminalAnnouncementCommand}" CommandParameter="{Binding}" Margin="4,0" />
                                                        <Button Grid.Row="0" Grid.Column="3" Grid.RowSpan="2" Content="{Binding $parent[UserControl].((vm:AdministrationViewModel)DataContext).Loc[DeleteAnnouncement]}" Command="{Binding $parent[UserControl].((vm:AdministrationViewModel)DataContext).DeleteTerminalAnnouncementCommand}" CommandParameter="{Binding}" Margin="4,0" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="{Binding Loc[AdminDangerZone]}" IsVisible="{Binding IsDatabaseOptionsView}">
                        <Border Background="#2A1A1A" BorderBrush="#EF5350" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,12,0,0">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{Binding Loc[AdminDangerZone]}" FontSize="16" FontWeight="SemiBold" Foreground="#EF9A9A" />
                                <Button Content="{Binding Loc[AdminDeleteDb]}" Command="{Binding AskDeleteDatabaseCommand}" IsEnabled="{Binding !IsBusy}" Foreground="#EF9A9A" />
                            </StackPanel>
                        </Border>
                    </TabItem>
                </TabControl>

                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <Border IsVisible="{Binding IsConfirmOpen}" Background="#CC000000" ZIndex="50">
            <Border Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="24" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <Button Content="✕" Command="{Binding CancelConfirmCommand}" ToolTip.Tip="Close"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-14,-14,0"
                            Padding="8,4" />
                    <TextBlock Text="{Binding ConfirmText}" TextWrapping="Wrap" />
                    <TextBox Text="{Binding ConfirmPhraseInput, Mode=TwoWay}" IsVisible="{Binding IsDeleteDatabaseConfirmation}" PlaceholderText="DELETE" MinWidth="260" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Content="{Binding Loc[Cancel]}" Command="{Binding CancelConfirmCommand}" HorizontalAlignment="Stretch" />
                        <Button Grid.Column="1" Content="{Binding Loc[AdminConfirm]}" Command="{Binding ConfirmCommand}" Classes="accent" HorizontalAlignment="Stretch" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
