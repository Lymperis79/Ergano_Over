<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ErganiManager.UI.ViewModels"
        x:Class="ErganiManager.UI.Views.BarcodeScanWindow"
        x:DataType="vm:WorkCardScanViewModel"
        Title="Ergani Manager — Barcode Scan"
        Width="520" Height="640"
        Topmost="True"
        CanResize="True"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto,Auto,*" Margin="20">

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="📟 Barcode Scan" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="Window stays on top. Each scan auto-focuses the input."
                       Foreground="Gray" FontSize="12" />
        </StackPanel>

        <!-- Scan input -->
        <Border Grid.Row="1" Background="#1A1D23" CornerRadius="8" Padding="16" Margin="0,0,0,12">
            <StackPanel Spacing="10">
                <TextBox Name="ScanInputBox"
                         Text="{Binding BarcodeInput}"
                         Watermark="Scan badge or type barcode..."
                         FontSize="20"
                         FontFamily="Consolas,Menlo,monospace"
                         IsEnabled="{Binding !IsProcessing}">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding SubmitScanCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>

                <CheckBox Content="Auto-detect Arrival / Departure"
                          IsChecked="{Binding AutoDetect}" />

                <StackPanel IsVisible="{Binding !AutoDetect}" Orientation="Horizontal" Spacing="20">
                    <RadioButton Content="🟢 Arrival"   IsChecked="{Binding IsArrival}" />
                    <RadioButton Content="🔴 Departure" IsChecked="{Binding !IsArrival}" />
                </StackPanel>

                <Button Content="Submit"
                        Command="{Binding SubmitScanCommand}"
                        IsEnabled="{Binding !IsProcessing}"
                        Classes="accent"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Height="42" FontSize="15" />
            </StackPanel>
        </Border>

        <!-- Response + history -->
        <Grid Grid.Row="2" RowDefinitions="Auto,Auto,*">

            <!-- Response -->
            <Border Grid.Row="0" IsVisible="{Binding HasResponse}"
                    CornerRadius="8" Padding="16" Margin="0,0,0,8"
                    Background="{Binding ResponseSuccess,
                        Converter={x:Static vm:BoolToBackgroundConverter.Instance}}">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding ResponseTitle}"
                               FontSize="14" FontWeight="Bold"
                               Foreground="White" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ResponseDetail}"
                               Foreground="White" TextWrapping="Wrap"
                               FontFamily="Consolas,Menlo,monospace" FontSize="11" />
                </StackPanel>
            </Border>

            <!-- History header -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                <TextBlock Grid.Column="0" Text="Recent Scans"
                           FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Clear"
                        Command="{Binding ClearHistoryCommand}"
                        IsVisible="{Binding RecentScans.Count}" />
            </Grid>

            <!-- History list -->
            <ScrollViewer Grid.Row="2">
                <ItemsControl ItemsSource="{Binding RecentScans}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ScanResultRow">
                            <Border Background="#1A1D23" CornerRadius="6" Padding="10,7">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding MovementIcon}"
                                               FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding TimeText}"
                                               FontFamily="Consolas,Menlo,monospace" FontSize="12"
                                               VerticalAlignment="Center" Foreground="#AAAAAA" Margin="0,0,10,0" />
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding EmployeeName}"
                                                   FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="{Binding StatusText}"
                                                   FontSize="11" Foreground="#888" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding StatusIcon}"
                                               FontSize="15" VerticalAlignment="Center" Margin="6,0,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </Grid>
    </Grid>

</Window>
