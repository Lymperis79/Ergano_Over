<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ErganiManager.UI.ViewModels"
        x:Class="ErganiManager.UI.Views.LoginView"
        x:DataType="vm:LoginViewModel"
        Title="Ergani Manager"
        Width="420" Height="440"
        WindowStartupLocation="CenterScreen"
        CanResize="False">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="320" Spacing="14">

            <TextBlock Text="{Binding Loc[AppTitle]}" FontSize="26" FontWeight="Bold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Loc[SignIn]}" Foreground="Gray"
                       HorizontalAlignment="Center" Margin="0,0,0,8" />

            <Border IsVisible="{Binding IsDegradedMode}"
                    Background="#332D9CDB" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                <TextBlock Text="{Binding Loc[OfflineBanner]}" TextWrapping="Wrap" FontSize="12" />
            </Border>

            <TextBlock Text="{Binding Loc[Username]}" FontWeight="SemiBold" />
            <TextBox Text="{Binding Username}" Watermark="{Binding Loc[Username]}" />

            <TextBlock Text="{Binding Loc[Password]}" FontWeight="SemiBold" />
            <TextBox Text="{Binding Password}" PasswordChar="•"
                     Watermark="{Binding Loc[Password]}" />

            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap"
                       IsVisible="{Binding ErrorMessage,
                           Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <Button Content="{Binding Loc[SignIn]}"
                    Command="{Binding LoginCommand}"
                    IsEnabled="{Binding !IsBusy}"
                    Classes="accent"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Margin="0,8,0,0" />

            <!-- Ergani API status -->
            <Border Background="#1A1D23" CornerRadius="6" Padding="12,8" Margin="0,12,0,0">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding ErganiStatusIcon}"
                               FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding ErganiStatusText}"
                                   Foreground="{Binding ErganiStatusColor}"
                                   FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="Press ⟳ to check if the Ergani API is reachable"
                                   FontSize="11" Foreground="#666666" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="⟳" FontSize="14" Padding="6,4"
                            Command="{Binding CheckErganiStatusCommand}"
                            IsEnabled="{Binding !IsCheckingErgani}"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>

        </StackPanel>
    </Grid>

</Window>
