<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ErganiManager.UI.ViewModels"
             x:Class="ErganiManager.UI.Views.BranchesView"
             x:DataType="vm:BranchesViewModel">

    <Grid RowDefinitions="Auto,*">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBlock Grid.Column="0" Text="{Binding Loc[Branches]}" FontSize="22" FontWeight="Bold" />
            <Button Grid.Column="1" Content="{Binding Loc[New]}"
                    Command="{Binding StartCreateCommand}" Classes="accent"
                    IsEnabled="{Binding HasActiveCompany}" />
        </Grid>

        <!-- No company selected warning -->
        <Border Grid.Row="1" IsVisible="{Binding !HasActiveCompany}"
                Background="#332D9CDB" CornerRadius="6" Padding="14">
            <TextBlock Text="{Binding NoCompanyMessage}" TextWrapping="Wrap" />
        </Border>

        <ScrollViewer Grid.Row="1" IsVisible="{Binding !IsEditing}">
            <ItemsControl ItemsSource="{Binding Branches}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1A1D23" CornerRadius="8" Padding="16">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding BranchNumber}"
                                           FontWeight="Bold" Width="32" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="{Binding Address}" FontSize="12" Foreground="Gray" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding IsActive}"
                                           VerticalAlignment="Center" Foreground="#999999"
                                           Margin="12,0" FontSize="12" />
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                                    <Button Content="Edit"   Tag="{Binding}" Click="OnEditClick" />
                                    <Button Content="Delete" Tag="{Binding}" Click="OnDeleteClick" Foreground="#EF9A9A" />
                                    <Button Content="Active" Tag="{Binding}" Click="OnToggleActiveClick" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="1" IsVisible="{Binding IsEditing}" RowDefinitions="*,Auto">
            <ScrollViewer Grid.Row="0">
                <Border Background="#1A1D23" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Branch Details" FontSize="17" FontWeight="SemiBold" />

                        <TextBlock Text="{Binding Loc[BranchNumber]}" FontWeight="SemiBold" />
                        <NumericUpDown Value="{Binding FormBranchNumber}" Minimum="1" Maximum="9999" />

                        <TextBlock Text="Display Name" FontWeight="SemiBold" />
                        <TextBox Text="{Binding FormName}" />

                        <TextBlock Text="{Binding Loc[Address]}" FontWeight="SemiBold" />
                        <TextBox Text="{Binding FormAddress}" />

                        <TextBlock Text="{Binding Loc[SepeCode]}" FontWeight="SemiBold" />
                        <TextBox Text="{Binding FormSepeServiceCode}" />

                        <TextBlock Text="OAED Service Code (optional)" FontWeight="SemiBold" />
                        <TextBox Text="{Binding FormOaedServiceCode}" />

                        <TextBlock Text="{Binding Loc[ActivityCode]}" FontWeight="SemiBold" />
                        <TextBox Text="{Binding FormActivityCode}" />

                        <TextBlock Text="{Binding Loc[MunicipalCode]}" FontWeight="SemiBold" />
                        <TextBox Text="{Binding FormKallikratisMunicipalCode}" />

                        <CheckBox Content="{Binding Loc[Active]}" IsChecked="{Binding FormIsActive}" />

                        <TextBlock Text="{Binding StatusMessage}" Foreground="Red"
                                   TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="0,8,0,0">
                <Button Grid.Column="0" Content="{Binding Loc[Cancel]}"
                        Command="{Binding CancelEditCommand}"
                        HorizontalAlignment="Stretch" Margin="0,0,6,0" />
                <Button Grid.Column="1" Content="{Binding Loc[Save]}"
                        Command="{Binding SaveCommand}" Classes="accent"
                        HorizontalAlignment="Stretch" Margin="6,0,0,0" />
            </Grid>
        </Grid>

    </Grid>

</UserControl>
