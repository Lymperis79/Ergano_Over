<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ErganiManager.UI.ViewModels"
             x:Class="ErganiManager.UI.Views.WorkCardScanView"
             x:DataType="vm:WorkCardScanViewModel">

    <Grid RowDefinitions="Auto,*">

        <TextBlock Grid.Row="0" Text="📟 Manual Work Card Scan"
                   FontSize="22" FontWeight="Bold" Margin="0,0,0,16" />

        <Border Grid.Row="1"
                IsVisible="{Binding !HasActiveCompany}"
                Background="#332D9CDB" CornerRadius="6" Padding="14">
            <TextBlock Text="{Binding NoCompanyMessage}" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="1" IsVisible="{Binding HasActiveCompany}"
              ColumnDefinitions="420,*" ColumnSpacing="20">

            <!-- Left: Scan form -->
            <StackPanel Grid.Column="0" Spacing="16">

                <!-- Input panel -->
                <Border Background="#1A1D23" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Barcode / Employee ID"
                                   FontWeight="SemiBold" FontSize="14" />

                        <TextBox Text="{Binding BarcodeInput}"
                                 Watermark="Scan badge or type barcode and press Enter..."
                                 FontSize="18"
                                 FontFamily="Consolas,Menlo,monospace"
                                 IsEnabled="{Binding !IsProcessing}">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter"
                                            Command="{Binding SubmitScanCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>

                        <CheckBox Content="Auto-detect Arrival / Departure"
                                  IsChecked="{Binding AutoDetect}" />

                        <!-- Manual override -->
                        <StackPanel IsVisible="{Binding !AutoDetect}" Spacing="10">
                            <TextBlock Text="Movement Type" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Spacing="24">
                                <RadioButton Content="🟢 Arrival"
                                             IsChecked="{Binding IsArrival}" />
                                <RadioButton Content="🔴 Departure"
                                             IsChecked="{Binding !IsArrival}" />
                            </StackPanel>

                            <TextBlock Text="Date" FontWeight="SemiBold" />
                            <CalendarDatePicker SelectedDate="{Binding MovementDate}"
                                                HorizontalAlignment="Stretch" />

                            <TextBlock Text="Time" FontWeight="SemiBold" />
                            <TimePicker SelectedTime="{Binding MovementTime}"
                                        ClockIdentifier="24HourClock" />
                        </StackPanel>

                        <Button Content="Submit"
                                Command="{Binding SubmitScanCommand}"
                                IsEnabled="{Binding !IsProcessing}"
                                Classes="accent"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Height="44" FontSize="15" />
                    </StackPanel>
                </Border>

                <!-- Response panel -->
                <Border IsVisible="{Binding HasResponse}"
                        CornerRadius="8" Padding="20"
                        Background="{Binding ResponseSuccess,
                            Converter={x:Static vm:BoolToBackgroundConverter.Instance}}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding ResponseTitle}"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="White" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ResponseDetail}"
                                   Foreground="White" TextWrapping="Wrap"
                                   FontFamily="Consolas,Menlo,monospace"
                                   FontSize="12" />
                        <Button Content="OK / Next scan"
                                Command="{Binding ClearResponseCommand}"
                                Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Tips -->
                <Border Background="#1A1D23" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="💡 Tips" FontWeight="SemiBold" Foreground="#AAAAAA" />
                        <TextBlock TextWrapping="Wrap" Foreground="#666666" FontSize="12"
                                   Text="Press Enter after typing the barcode to submit. Auto-detect picks the opposite of the last recorded movement for that employee. Failed submissions are queued and retried automatically when Ergani recovers." />
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- Right: Recent history -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*">

                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <TextBlock Grid.Column="0" Text="Recent Scans This Session"
                               FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Clear"
                            Command="{Binding ClearHistoryCommand}"
                            IsVisible="{Binding RecentScans.Count}" />
                </Grid>

                <ScrollViewer Grid.Row="1">
                    <StackPanel Spacing="4">
                        <TextBlock Text="No scans yet."
                                   Foreground="Gray" FontSize="13"
                                   IsVisible="{Binding !RecentScans.Count}" />

                        <ItemsControl ItemsSource="{Binding RecentScans}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ScanResultRow">
                                    <Border Background="#1A1D23" CornerRadius="6" Padding="12,8">
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding MovementIcon}"
                                                       FontSize="16"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding TimeText}"
                                                       FontFamily="Consolas,Menlo,monospace"
                                                       FontSize="13"
                                                       VerticalAlignment="Center"
                                                       Foreground="#AAAAAA"
                                                       Margin="0,0,12,0" />
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{Binding EmployeeName}"
                                                           FontWeight="SemiBold"
                                                           FontSize="13" />
                                                <TextBlock Text="{Binding StatusText}"
                                                           FontSize="11"
                                                           Foreground="#888888"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding StatusIcon}"
                                                       FontSize="16"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </Grid>

    </Grid>

</UserControl>
