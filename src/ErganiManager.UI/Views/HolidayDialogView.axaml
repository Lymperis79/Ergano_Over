<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ErganiManager.UI.ViewModels"
             xmlns:cm="using:ErganiManager.Core.Models"
             x:Class="ErganiManager.UI.Views.HolidayDialogView"
             x:DataType="vm:HolidayDialogViewModel">

    <Grid>
        <!-- ── Holidays form + list ── -->
        <Border Background="#BB000000">
            <Border Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="20"
                    MaxWidth="1100" MaxHeight="680" Margin="12"
                    VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <Grid RowDefinitions="Auto,*,Auto,Auto,*,Auto" RowSpacing="10">
                    <Button Content="✕" Command="{Binding CloseCommand}" ToolTip.Tip="Close"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-14,-14,0"
                            Padding="8,4" />

                    <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="17" FontWeight="Bold" />

                    <!-- Form: scroll when the available popup height is limited -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                          ColumnSpacing="12" RowSpacing="8">

                        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Spacing="4">
                            <TextBlock Text="{Binding Loc[HolidayType]}" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding LeaveTypeOptions}"
                                      SelectedItem="{Binding SelectedType}"
                                      PlaceholderText="{Binding Loc[SelectTheHolidayType]}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="cm:LeaveTypeInfo">
                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4">
                            <TextBlock Text="{Binding Loc[Branch]}" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding Branches}"
                                      SelectedItem="{Binding SelectedBranch}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                            <TextBlock Text="{Binding Loc[From]}" FontWeight="SemiBold" />
                            <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="150" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                            <TextBlock Text="{Binding Loc[ToInclusive]}" FontWeight="SemiBold" />
                            <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="150" />
                        </StackPanel>
                        <CheckBox Grid.Row="1" Grid.Column="2" Content="{Binding Loc[SkipSaturdaySunday]}"
                                  IsChecked="{Binding SkipWeekends}" VerticalAlignment="Bottom" />

                        <StackPanel Grid.Row="2" Grid.Column="0" Spacing="4" IsVisible="{Binding IsHourlyType}">
                            <TextBlock Text="{Binding Loc[HoursFromHourlyTypes]}" FontWeight="SemiBold" />
                            <TimePicker SelectedTime="{Binding StartTime}" ClockIdentifier="24HourClock" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4" IsVisible="{Binding IsHourlyType}">
                            <TextBlock Text="{Binding Loc[HoursTo]}" FontWeight="SemiBold" />
                            <TimePicker SelectedTime="{Binding EndTime}" ClockIdentifier="24HourClock" />
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0" Spacing="4">
                            <TextBlock Text="{Binding Loc[ReferenceYearOptional]}" FontWeight="SemiBold" />
                            <TextBox Text="{Binding ReferenceYear}" PlaceholderText="e.g. 2026" MaxLength="4" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="1" Spacing="4">
                            <TextBlock Text="{Binding Loc[EntitledLeaveDaysOptional]}" FontWeight="SemiBold" />
                            <TextBox Text="{Binding EntitledDays}" PlaceholderText="e.g. 20" MaxLength="3" />
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Spacing="4">
                            <TextBlock Text="{Binding Loc[CommentsOptionalMax200]}" FontWeight="SemiBold" />
                            <TextBox Text="{Binding Comments}" MaxLength="200" />
                        </StackPanel>
                    </Grid>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Content="{Binding Loc[CancelEdit]}" Command="{Binding CancelEditCommand}" IsVisible="{Binding IsEditingExisting}" />
                        <Button Content="{Binding Loc[Save2]}" Command="{Binding SaveCommand}" />
                        <Button Content="{Binding Loc[SaveSubmit]}" Command="{Binding SaveAndSubmitCommand}" Classes="accent" />
                    </StackPanel>

                    <!-- List header -->
                    <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding Loc[HolidaysOfThisEmployee]}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="{Binding SubmitUnsentText}"
                                Command="{Binding SubmitUnsentCommand}" />
                    </Grid>

                    <!-- List -->
                    <Panel Grid.Row="4">
                        <TextBlock Text="{Binding Loc[NoHolidaysRecordedForThisEmployee]}"
                                   Foreground="Gray" IsVisible="{Binding !HasRows}" />
                        <ScrollViewer IsVisible="{Binding HasRows}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:HolidayRow">
                                        <Border Background="{DynamicResource HoverBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,0,4">
                                            <Grid ColumnDefinitions="Auto,92,*,100,230,Auto,Auto,Auto,Auto" ColumnSpacing="10">
                                                <TextBlock Grid.Column="0" Text="{Binding StatusIcon}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding DateText}" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding TypeText}" FontSize="12"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                           ToolTip.Tip="{Binding TypeText}" />
                                                <TextBlock Grid.Column="3" Text="{Binding HoursText}" FontSize="12"
                                                           Foreground="#AAAAAA" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="4" Text="{Binding Summary}" FontSize="12"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                           ToolTip.Tip="{Binding Summary}" />
                                                <Button Grid.Column="5" Content="{Binding $parent[UserControl].((vm:HolidayDialogViewModel)DataContext).Loc[ResponseLabel]}"
                                                        Tag="{Binding}" Click="OnResponseClick" />
                                                <Button Grid.Column="6" Content="{Binding $parent[UserControl].((vm:HolidayDialogViewModel)DataContext).Loc[PdfLabel]}"
                                                        Tag="{Binding}" Click="OnPdfClick"
                                                        IsEnabled="{Binding HasProtocol}" />
                                                <Button Grid.Column="7" Content="{Binding $parent[UserControl].((vm:HolidayDialogViewModel)DataContext).Loc[Edit]}"
                                                        Tag="{Binding}" Click="OnEditClick"
                                                        IsVisible="{Binding IsUnsent}" />
                                                <Button Grid.Column="8" Content="🗑"
                                                        Tag="{Binding}" Click="OnDeleteClick"
                                                        IsVisible="{Binding IsUnsent}" Foreground="#EF9A9A" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Panel>

                    <Grid Grid.Row="5" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" TextWrapping="Wrap"
                                   VerticalAlignment="Center" Foreground="Gray" />
                        <Button Grid.Column="1" Content="{Binding Loc[Close]}" Command="{Binding CloseCommand}" Width="100" />
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- ── Raw Ergani response ── -->
        <Border Background="#AA000000" IsVisible="{Binding IsResponseOpen}">
            <Border Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="20"
                    Width="800" Height="520"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                    <Button Content="✕" Command="{Binding CloseResponseCommand}" ToolTip.Tip="Close"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-14,-14,0"
                            Padding="8,4" />
                    <TextBlock Grid.Row="0" Text="{Binding ResponseTitle}" FontSize="17" FontWeight="Bold" />
                    <TextBox Grid.Row="1" Text="{Binding ResponseText}" IsReadOnly="True"
                             AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas"
                             ScrollViewer.VerticalScrollBarVisibility="{x:Static ScrollBarVisibility.Auto}"
                             ScrollViewer.HorizontalScrollBarVisibility="{x:Static ScrollBarVisibility.Auto}" />
                    <Button Grid.Row="2" Content="{Binding Loc[Close]}" Command="{Binding CloseResponseCommand}"
                            HorizontalAlignment="Right" Width="100" />
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
