<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ErganiManager.UI.ViewModels"
             x:Class="ErganiManager.UI.Views.EmailLogView"
             x:DataType="vm:EmailLogViewModel">

    <!-- The shell does not scroll its sections: the page scrolls here, the list scrolls inside it. -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Margin="0,0,14,0">

            <Border IsVisible="{Binding !HasActiveCompany}" Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="14">
                <TextBlock Text="{Binding NoCompanyMessage}" TextWrapping="Wrap" />
            </Border>

            <StackPanel IsVisible="{Binding HasActiveCompany}" Spacing="12">

                <TextBlock Text="{Binding Loc[EmailLogTitle]}" FontSize="22" FontWeight="Bold" />
                <TextBlock Text="{Binding Loc[EmailLogHint]}" Foreground="Gray" FontSize="12" TextWrapping="Wrap" />

                <!-- Filters -->
                <WrapPanel HorizontalAlignment="Left" MaxWidth="{Binding $parent[ScrollViewer].Viewport.Width}">
                    <StackPanel Spacing="4" Margin="0,0,12,8">
                        <TextBlock Text="{Binding Loc[From]}" FontSize="12" Foreground="Gray" />
                        <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}" MinWidth="150" />
                    </StackPanel>
                    <StackPanel Spacing="4" Margin="0,0,12,8">
                        <TextBlock Text="{Binding Loc[To]}" FontSize="12" Foreground="Gray" />
                        <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}" MinWidth="150" />
                    </StackPanel>
                    <StackPanel Spacing="4" Margin="0,0,12,8">
                        <TextBlock Text="{Binding Loc[EmailColStatus]}" FontSize="12" Foreground="Gray" />
                        <ComboBox ItemsSource="{Binding StatusOptions}" SelectedIndex="{Binding StatusFilter, Mode=TwoWay}" MinWidth="200" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,8">
                        <Button Content="{Binding Loc[EmailRefresh]}" Command="{Binding LoadCommand}" Classes="accent" />
                    </StackPanel>
                </WrapPanel>

                <TextBlock Text="{Binding StatusMessage}" Foreground="Gray" TextWrapping="Wrap" />

                <!-- List -->
                <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="8">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel MinWidth="940" Spacing="4">
                            <Grid ColumnDefinitions="150,170,150,*,260" Margin="14,4">
                                <TextBlock Text="{Binding Loc[EmailColTime]}" Foreground="Gray" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="{Binding Loc[EmailColEvent]}" Foreground="Gray" FontSize="12" />
                                <TextBlock Grid.Column="2" Text="{Binding Loc[EmailColStatus]}" Foreground="Gray" FontSize="12" />
                                <TextBlock Grid.Column="3" Text="{Binding Loc[EmailColSubject]}" Foreground="Gray" FontSize="12" />
                                <TextBlock Grid.Column="4" Text="{Binding Loc[EmailColRecipients]}" Foreground="Gray" FontSize="12" />
                            </Grid>
                            <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" MaxHeight="340"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:EmailLogRow">
                                        <Grid ColumnDefinitions="150,170,150,*,260">
                                            <TextBlock Text="{Binding TimeText}" />
                                            <TextBlock Grid.Column="1" Text="{Binding EventText}" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding StatusIcon}" />
                                                <TextBlock Text="{Binding StatusText}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="3" Text="{Binding Subject}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                            <TextBlock Grid.Column="4" Text="{Binding Recipients}" TextTrimming="CharacterEllipsis" Foreground="Gray" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- The selected mail, exactly as it was written -->
                <Border IsVisible="{Binding HasSelection}" Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding Loc[EmailDetails]}" FontSize="16" FontWeight="SemiBold" />
                        <TextBox Text="{Binding SelectedRow.DetailsText, Mode=OneWay}" IsReadOnly="True"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="260" MaxHeight="420"
                                 FontFamily="Consolas, Menlo, monospace" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
