<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ErganiManager.UI.ViewModels"
             x:Class="ErganiManager.UI.Views.EmployeesView"
             x:DataType="vm:EmployeesViewModel">

    <Grid RowDefinitions="Auto,*">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,12">
            <TextBlock Grid.Column="0" Text="{Binding Loc[Employees]}" FontSize="22" FontWeight="Bold" />
            <Button Grid.Column="1" Content="{Binding Loc[ImportFromExcel]}"
                    Command="{Binding RequestImportCommand}" Margin="0,0,8,0" />
            <Button Grid.Column="2" Content="{Binding Loc[New]}"
                    Command="{Binding StartCreateCommand}" Classes="accent" />
        </Grid>

        <ScrollViewer Grid.Row="1" IsVisible="{Binding !IsEditing}">
            <ItemsControl ItemsSource="{Binding Employees}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1A1D23" CornerRadius="8" Padding="16">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="{Binding TaxId}" FontSize="12" Foreground="Gray" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding BarcodeId}"
                                           VerticalAlignment="Center" Foreground="#999999"
                                           Margin="12,0" FontSize="12"
                                           FontFamily="Consolas,Menlo,monospace" />
                                <TextBlock Grid.Column="2" Text="{Binding IsActive}"
                                           VerticalAlignment="Center" Foreground="#999999"
                                           Margin="12,0" FontSize="12" />
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                                    <Button Content="Edit"   Tag="{Binding}" Click="OnEditClick" />
                                    <Button Content="Delete" Tag="{Binding}" Click="OnDeleteClick" Foreground="#EF9A9A" />
                                    <Button Content="Active" Tag="{Binding}" Click="OnToggleActiveClick" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="1" IsVisible="{Binding IsEditing}" RowDefinitions="*,Auto">
            <ScrollViewer Grid.Row="0">
                <Border Background="#1A1D23" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Employee Details" FontSize="17" FontWeight="SemiBold" />

                        <TextBlock Text="{Binding Loc[FirstName]}" FontWeight="SemiBold" />
                        <TextBox Text="{Binding FormFirstName}" />

                        <TextBlock Text="{Binding Loc[LastName]}" FontWeight="SemiBold" />
                        <TextBox Text="{Binding FormLastName}" />

                        <TextBlock Text="{Binding Loc[TaxId]}" FontWeight="SemiBold" />
                        <TextBox Text="{Binding FormTaxId}" MaxLength="9" />

                        <TextBlock Text="{Binding Loc[Amka]}" FontWeight="SemiBold" />
                        <TextBox Text="{Binding FormSocialSecurityNumber}" MaxLength="11" />

                        <TextBlock Text="{Binding Loc[BarcodeId]}" FontWeight="SemiBold" />
                        <TextBox Text="{Binding FormBarcodeId}"
                                 FontFamily="Consolas,Menlo,monospace" />

                        <TextBlock Text="{Binding Loc[ProfessionCode]}" FontWeight="SemiBold" />
                        <TextBox Text="{Binding FormProfessionCode}" />

                        <TextBlock Text="{Binding Loc[WeeklyWorkdays]}" FontWeight="SemiBold" />
                        <NumericUpDown Value="{Binding FormWeeklyWorkdays}"
                                       Minimum="5" Maximum="6" />

                        <TextBlock Text="{Binding Loc[Branch]}" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding AvailableBranches}"
                                  SelectedItem="{Binding FormBranch}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <CheckBox Content="{Binding Loc[Active]}" IsChecked="{Binding FormIsActive}" />

                        <TextBlock Text="{Binding StatusMessage}" Foreground="Red"
                                   TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="0,8,0,0">
                <Button Grid.Column="0" Content="{Binding Loc[Cancel]}"
                        Command="{Binding CancelEditCommand}"
                        HorizontalAlignment="Stretch" Margin="0,0,6,0" />
                <Button Grid.Column="1" Content="{Binding Loc[Save]}"
                        Command="{Binding SaveCommand}" Classes="accent"
                        HorizontalAlignment="Stretch" Margin="6,0,0,0" />
            </Grid>
        </Grid>

    </Grid>

</UserControl>
