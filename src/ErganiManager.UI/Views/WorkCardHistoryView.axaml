<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ErganiManager.UI.ViewModels"
             x:Class="ErganiManager.UI.Views.WorkCardHistoryView"
             x:DataType="vm:WorkCardHistoryViewModel">

    <StackPanel Spacing="16">

        <!-- No active company -->

        <Border IsVisible="{Binding !HasActiveCompany}"
                Background="#332D9CDB"
                CornerRadius="6"
                Padding="14">

            <TextBlock Text="{Binding NoCompanyMessage}"
                       TextWrapping="Wrap" />

        </Border>

        <StackPanel IsVisible="{Binding HasActiveCompany}"
                    Spacing="14">

            <!-- Header -->

            <Grid ColumnDefinitions="*,Auto">

                <TextBlock Grid.Column="0"
                           Text="{Binding Loc[WorkCards]}"
                           FontSize="22"
                           FontWeight="Bold" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="{Binding Loc[OpenWorkCardsPortal]}"
                            Command="{Binding OpenErganiWorkCardsPortalCommand}"
                            IsEnabled="{Binding !IsLoading}" />
                    <Button Content="⬇ Export to Excel"
                            Command="{Binding ExportToExcelCommand}"
                            IsEnabled="{Binding !IsLoading}" />
                </StackPanel>

            </Grid>

            <!-- Filters -->

            <Border Background="#1A1D23"
                    CornerRadius="8"
                    Padding="16">

                <StackPanel Spacing="14">

                    <TextBlock Text="Filters"
                               FontWeight="SemiBold"
                               FontSize="14" />

                    <!-- Date filters -->

                    <WrapPanel Orientation="Horizontal">

                        <!-- From -->

                        <StackPanel Spacing="5"
                                    Margin="0,0,20,0">

                            <TextBlock Text="From"
                                       FontSize="12"
                                       Foreground="Gray" />

                            <DatePicker SelectedDate="{Binding FilterFromDate, Mode=TwoWay}"
                                        MinWidth="180"
                                        HorizontalAlignment="Left" />

                        </StackPanel>

                        <!-- To -->

                        <StackPanel Spacing="5"
                                    Margin="0,0,20,0">

                            <TextBlock Text="To"
                                       FontSize="12"
                                       Foreground="Gray" />

                            <DatePicker SelectedDate="{Binding FilterToDate, Mode=TwoWay}"
                                        MinWidth="180"
                                        HorizontalAlignment="Left" />

                        </StackPanel>

                        <!-- Employee -->

                        <StackPanel Spacing="5"
                                    Margin="0,0,20,0">

                            <TextBlock Text="Employee"
                                       FontSize="12"
                                       Foreground="Gray" />

                            <ComboBox ItemsSource="{Binding AvailableEmployees}"
                                      SelectedItem="{Binding FilterEmployee}"
                                      MinWidth="220"
                                      HorizontalAlignment="Left">

                                <ComboBox.ItemTemplate>

                                    <DataTemplate>

                                        <TextBlock Text="{Binding FullName}" />

                                    </DataTemplate>

                                </ComboBox.ItemTemplate>

                            </ComboBox>

                        </StackPanel>

                        <!-- Branch -->

                        <StackPanel Spacing="5">

                            <TextBlock Text="Branch"
                                       FontSize="12"
                                       Foreground="Gray" />

                            <ComboBox ItemsSource="{Binding AvailableBranches}"
                                      SelectedItem="{Binding FilterBranch}"
                                      MinWidth="220"
                                      HorizontalAlignment="Left">

                                <ComboBox.ItemTemplate>

                                    <DataTemplate>

                                        <TextBlock Text="{Binding Name}" />

                                    </DataTemplate>

                                </ComboBox.ItemTemplate>

                            </ComboBox>

                        </StackPanel>

                    </WrapPanel>

                    <!-- Options / Load -->

                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto"
                          ColumnSpacing="10">

                        <CheckBox Grid.Column="0"
                                  Content="{Binding Loc[EarlyDeparture]}"
                                  IsChecked="{Binding FilterEarlyDepartureOnly}"
                                  VerticalAlignment="Center" />

                        <TextBlock Grid.Column="2"
                                   Text="{Binding StatusMessage}"
                                   Foreground="Gray"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,12,0"
                                   TextWrapping="Wrap" />

                        <Button Grid.Column="3"
                                Content="☑ Select retryable"
                                Command="{Binding SelectAllRetryableCommand}"
                                VerticalAlignment="Center" />

                        <Button Grid.Column="4"
                                Content="🔄 Retry selected"
                                Command="{Binding RetrySelectedCommand}"
                                Classes="accent"
                                VerticalAlignment="Center" />

                        <Button Grid.Column="1"
                                Content="{Binding Loc[Load]}"
                                Command="{Binding LoadCommand}"
                                IsEnabled="{Binding !IsLoading}"
                                Classes="accent"
                                VerticalAlignment="Center" />

                    </Grid>

                </StackPanel>

            </Border>

            <!-- Results list -->

            <ItemsControl ItemsSource="{Binding Records}">

                <ItemsControl.ItemsPanel>

                    <ItemsPanelTemplate>

                        <StackPanel Spacing="4" />

                    </ItemsPanelTemplate>

                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <Border Background="#1A1D23"
                                CornerRadius="6"
                                Padding="14,10">

                            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,Auto,Auto">

                                <!-- Retry selection -->

                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          IsVisible="{Binding CanRetry}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0"
                                          ToolTip.Tip="Select this failed/waiting work card for retry" />

                                <!-- Movement icon -->

                                <TextBlock Grid.Column="1"
                                           Width="28"
                                           FontSize="18"
                                           VerticalAlignment="Center"
                                           Text="{Binding MovementType,
                                                  Converter={x:Static vm:MovementTypeIconConverter.Instance}}" />

                                <!-- Employee + branch -->

                                <StackPanel Grid.Column="2"
                                            VerticalAlignment="Center">

                                    <TextBlock Text="{Binding EmployeeFullName}"
                                               FontWeight="SemiBold"
                                               FontSize="13" />

                                    <TextBlock Text="{Binding BranchName}"
                                               FontSize="11"
                                               Foreground="Gray" />

                                </StackPanel>

                                <!-- Date/time -->

                                <TextBlock Grid.Column="3"
                                           Text="{Binding MovementDateTime,
                                                  StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                                           VerticalAlignment="Center"
                                           Margin="12,0"
                                           FontFamily="Consolas,Menlo,monospace"
                                           FontSize="12" />

                                <!-- Early departure -->

                                <Border Grid.Column="4"
                                        IsVisible="{Binding WasEarlyDeparture}"
                                        Background="#4E342E"
                                        CornerRadius="10"
                                        Padding="8,3"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0">

                                    <TextBlock Text="{Binding EarlyDepartureMinutes,
                                                  StringFormat='⚠️ {0} min early'}"
                                               FontSize="11"
                                               Foreground="#FFAB91" />

                                </Border>

                                <!-- Ergani / offline status -->

                                <Border Grid.Column="5"
                                        CornerRadius="10"
                                        Padding="8,3"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0">

                                    <TextBlock Text="{Binding StatusText}"
                                               FontSize="11"
                                               Foreground="White"
                                               TextWrapping="Wrap" />

                                </Border>

                                <!-- Protocol -->

                                <TextBlock Grid.Column="6" Text="{Binding Protocol}" FontSize="11" Foreground="#888888" VerticalAlignment="Center" IsVisible="{Binding Protocol, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <Button Grid.Column="7" Content="Response" Tag="{Binding}" Click="OnResponseClick" IsEnabled="{Binding SubmittedToErgani}" Margin="6,0" />
                                <Button Grid.Column="8" Content="PDF" Tag="{Binding}" Click="OnPdfClick" IsEnabled="{Binding SubmittedToErgani}" />

                            </Grid>

                        </Border>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </StackPanel>

    <Border IsVisible="{Binding IsResponseOpen}" Background="#AA000000" ZIndex="100">
        <Border Background="#1E2128" CornerRadius="12" Padding="20" Width="800" Height="600" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                <TextBlock Grid.Row="0" Text="{Binding ResponseTitle}" FontSize="17" FontWeight="Bold" />
                <TextBox Grid.Row="1" Text="{Binding ResponseText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="{x:Static ScrollBarVisibility.Auto}" ScrollViewer.HorizontalScrollBarVisibility="{x:Static ScrollBarVisibility.Auto}" FontFamily="Consolas" />
                <Button Grid.Row="2" Content="Close" Command="{Binding CloseResponseCommand}" HorizontalAlignment="Right" Width="100" />
            </Grid>
        </Border>
    </Border>

    </StackPanel>

</UserControl>

