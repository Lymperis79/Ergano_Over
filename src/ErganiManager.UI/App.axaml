<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ErganiManager.UI.App"
             RequestedThemeVariant="Default">

    <Application.Styles>
        <FluentTheme />

        <!-- Softer look for all buttons and input boxes: rounded corners, hand cursor.
             Sidebar menu items (Button.navItem / navGroup) keep their own flat style. -->
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="#2D9CDB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#258AC4" />
        </Style>
    </Application.Styles>

</Application>
