<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ErganiManager.Android"
             x:Class="ErganiManager.Android.MainView"
             x:DataType="vm:MainViewModel">
  <Grid RowDefinitions="Auto,Auto,*" Background="#141820">
    <Border Grid.Row="0" Background="#1D2634" Padding="20,18">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <StackPanel Grid.Column="0" Spacing="5">
          <TextBlock Text="ERGANI MANAGER" FontSize="12" FontWeight="Bold"
                     Foreground="#8BBCEB" />
          <TextBlock Text="{Binding PageTitle}" FontSize="25" FontWeight="Bold"
                     Foreground="White" />
          <TextBlock Text="Mobile workspace" FontSize="13" Foreground="#AAB7C8" />
        </StackPanel>
        <Button Grid.Column="1" Content="Sign out" Command="{Binding LogoutCommand}"
                VerticalAlignment="Center" IsVisible="{Binding IsAuthenticated}" />
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="#202B3A" Padding="14,8"
            IsVisible="{Binding IsAuthenticated}">
      <Button Content="⌂  Overview" Command="{Binding GoToOverviewCommand}"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
              MinHeight="42" />
    </Border>

    <ScrollViewer Grid.Row="2">
      <StackPanel Margin="18" Spacing="16">
        <Border Background="#202B3A" CornerRadius="18" Padding="20"
                IsVisible="{Binding !IsAuthenticated}">
          <StackPanel Spacing="12">
            <TextBlock Text="ERGANI MANAGER" FontSize="13" FontWeight="Bold"
                       Foreground="#8BBCEB" />
            <TextBlock Text="Sign in to your account" FontSize="22" FontWeight="Bold"
                       Foreground="White" />
            <TextBlock Text="Use your existing Ergani II account to securely access your company."
                       TextWrapping="Wrap" Foreground="#C3CEDB" FontSize="13" />
            <TextBox PlaceholderText="HTTPS API address" Text="{Binding ServerAddress}" />
            <TextBox PlaceholderText="Username" Text="{Binding Username}" />
            <TextBox PlaceholderText="Password" Text="{Binding Password}" PasswordChar="●" />
            <Button Content="Sign in" HorizontalAlignment="Stretch"
                    Command="{Binding ConnectCommand}" IsEnabled="{Binding !IsBusy}" />
            <Button Content="Check API health" HorizontalAlignment="Stretch"
                    Command="{Binding CheckApiHealthCommand}" IsEnabled="{Binding !IsBusy}" />
            <TextBlock Text="{Binding ConnectionMessage}" TextWrapping="Wrap"
                       Foreground="#C3CEDB" FontSize="12" />
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                       Foreground="#AAB7C8" FontSize="12" />
            <TextBlock Text="Your password is not saved by the mobile app."
                       Foreground="#AAB7C8" FontSize="11" />
          </StackPanel>
        </Border>

        <StackPanel Spacing="16" IsVisible="{Binding IsAuthenticated}">
        <Border Background="#202B3A" CornerRadius="16" Padding="14" IsVisible="{Binding IsCompanySelectionRequired}">
          <StackPanel Spacing="10">
            <TextBlock Text="SELECT COMPANY" Foreground="#8BBCEB" FontWeight="Bold" FontSize="12" />
            <TextBlock Text="Your account can access more than one company. Select the company whose data you want to open."
                       Foreground="#C3CEDB" FontSize="13" TextWrapping="Wrap" />
            <ComboBox ItemsSource="{Binding Companies}"
                      SelectedItem="{Binding SelectedCompany}"
                      PlaceholderText="Choose a company"
                      HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:MobileCompany">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Content="Continue with selected company"
                    Command="{Binding SelectCompanyCommand}"
                    IsEnabled="{Binding !IsBusy}" />
            <TextBlock Text="{Binding StatusMessage}" Foreground="#C3CEDB" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
        </Border>


        <Border Background="#202B3A" CornerRadius="16" Padding="14" IsVisible="{Binding IsWorkCardsVisible}">
          <StackPanel Spacing="12">
            <TextBlock Text="WORK CARDS · SCAN &amp; HISTORY" Foreground="#8BBCEB" FontWeight="Bold" FontSize="12" />
            <TextBlock Text="Scan an employee barcode with your phone camera, or type the employee number below."
                       Foreground="#C3CEDB" FontSize="13" TextWrapping="Wrap" />
            <TextBox PlaceholderText="Employee number, AFM or barcode"
                     Text="{Binding WorkCardScanInput, Mode=TwoWay}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
              <Button Grid.Column="0" Content="📷 Camera scan"
                      Command="{Binding OpenBarcodeCameraCommand}"
                      IsEnabled="{Binding !IsWorkCardScanBusy}" />
              <Button Grid.Column="1" Content="Submit scan"
                      Command="{Binding SubmitWorkCardScanCommand}"
                      IsEnabled="{Binding !IsWorkCardScanBusy}" />
            </Grid>
            <ProgressBar IsIndeterminate="True" Height="4"
                         IsVisible="{Binding IsWorkCardScanBusy}" />
            <TextBlock Text="{Binding WorkCardScanMessage}" Foreground="#F0C674"
                       FontSize="13" TextWrapping="Wrap" />
            <CalendarDatePicker SelectedDate="{Binding WorkCardFromDatePicker, Mode=TwoWay}"
                                PlaceholderText="From date"
                                SelectedDateFormat="Custom"
                                CustomDateFormatString="dd/MM/yyyy" />
            <CalendarDatePicker SelectedDate="{Binding WorkCardToDatePicker, Mode=TwoWay}"
                                PlaceholderText="To date"
                                SelectedDateFormat="Custom"
                                CustomDateFormatString="dd/MM/yyyy" />
            <ComboBox ItemsSource="{Binding Employees}"
                      SelectedItem="{Binding SelectedWorkCardEmployee}"
                      PlaceholderText="All employees"
                      HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:MobileEmployee">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding FirstName}" Foreground="White" />
                    <TextBlock Text="{Binding LastName}" Foreground="#AAB7C8" FontSize="12" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Content="Refresh work cards" Command="{Binding RefreshWorkCardsCommand}" IsEnabled="{Binding !IsBusy}" />
            <TextBlock Text="{Binding WorkCardsMessage}" Foreground="#C3CEDB" FontSize="13" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding WorkCardHistory}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MobileWorkCardHistoryItem">
                  <Border Background="#293749" CornerRadius="10" Padding="12" Margin="0,4">
                    <StackPanel Spacing="5">
                      <TextBlock Text="{Binding EmployeeFullName}" Foreground="White" FontWeight="SemiBold" FontSize="16" />
                      <TextBlock Text="{Binding MovementText}" Foreground="#8BBCEB" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding DateTimeText}" Foreground="#E0E7EF" />
                      <TextBlock Text="{Binding BranchName}" Foreground="#AAB7C8" FontSize="12" />
                      <TextBlock Text="{Binding StatusText}" Foreground="#F0C674" FontSize="12" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding LateReasonText}" Foreground="#C3CEDB" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding HasLateReason}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Background="#202B3A" CornerRadius="16" Padding="14" IsVisible="{Binding IsWorkCalendarVisible}">
          <StackPanel Spacing="12">
            <TextBlock Text="WORK CALENDAR" Foreground="#8BBCEB" FontWeight="Bold" FontSize="12" />
            <ComboBox ItemsSource="{Binding Employees}"
                      SelectedItem="{Binding SelectedCalendarEmployee}"
                      PlaceholderText="Select employee"
                      HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:MobileEmployee">
                  <TextBlock Text="{Binding FirstName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
              <Button Grid.Column="0" Content="‹" Command="{Binding PreviousCalendarMonthCommand}" />
              <CalendarDatePicker Grid.Column="1"
                                     SelectedDate="{Binding SelectedCalendarDate, Mode=TwoWay}"
                                     PlaceholderText="Select month"
                                     SelectedDateFormat="Custom"
                                     CustomDateFormatString="MMMM yyyy" />
              <Button Grid.Column="2" Content="›" Command="{Binding NextCalendarMonthCommand}" />
            </Grid>
            <Button Content="Load month" Command="{Binding RefreshWorkCalendarCommand}" IsEnabled="{Binding !IsBusy}" />
            <TextBlock Text="{Binding WorkCalendarMessage}" Foreground="#C3CEDB" FontSize="13" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding WorkCalendarDays}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MobileScheduleDay">
                  <Border Background="#293749" CornerRadius="10" Padding="12" Margin="0,4">
                    <StackPanel Spacing="5">
                      <TextBlock Text="{Binding ScheduleDate}" Foreground="White" FontWeight="SemiBold" FontSize="15" />
                      <TextBlock Text="{Binding WorkTypeText}" Foreground="#8BBCEB" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding PlannedTimeText}" Foreground="#E0E7EF" />
                      <TextBlock Text="{Binding ActualTimeText}" Foreground="#C3CEDB" FontSize="12" />
                      <TextBlock Text="{Binding SubmissionText}" Foreground="#F0C674" FontSize="12" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Background="#202B3A" CornerRadius="16" Padding="14" IsVisible="{Binding IsDailyStatusVisible}">
          <StackPanel Spacing="12">
            <TextBlock Text="DAILY ATTENDANCE" Foreground="#8BBCEB" FontWeight="Bold" FontSize="12" />
            <CalendarDatePicker SelectedDate="{Binding SelectedStatusDatePicker, Mode=TwoWay}"
                                PlaceholderText="Select date"
                                SelectedDateFormat="Custom"
                                CustomDateFormatString="dd/MM/yyyy" />
            <TextBox PlaceholderText="Grace minutes (0–240)" Text="{Binding GraceMinutes}" />
            <Button Content="Refresh daily status" Command="{Binding RefreshDailyStatusCommand}" IsEnabled="{Binding !IsBusy}" />
            <TextBlock Text="{Binding DailyStatusMessage}" Foreground="#C3CEDB" FontSize="13" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding TodayStatuses}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MobileTodayEmployeeStatus">
                  <Border Background="#293749" CornerRadius="10" Padding="12" Margin="0,4">
                    <StackPanel Spacing="5">
                      <TextBlock Text="{Binding FullName}" Foreground="White" FontWeight="SemiBold" FontSize="16" />
                      <TextBlock Text="{Binding BranchName}" Foreground="#AAB7C8" FontSize="12" />
                      <TextBlock Text="{Binding PresenceText}" Foreground="#8BBCEB" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding ScheduleText}" Foreground="#E0E7EF" />
                      <TextBlock Text="{Binding PlannedHours}" Foreground="#C3CEDB" FontSize="12" />
                      <TextBlock Text="{Binding ClockingText}" Foreground="#C3CEDB" FontSize="12" />
                      <TextBlock Text="{Binding LevelText}" Foreground="#F0C674" FontSize="12" />
                      <TextBlock Text="{Binding IssueSummary}" Foreground="#AAB7C8" FontSize="12" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <TextBlock Text="WORKING DAY" Foreground="#8BBCEB" FontWeight="Bold"
                   FontSize="12" IsVisible="{Binding IsOverviewVisible}" />
        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12" IsVisible="{Binding IsOverviewVisible}">
          <Button Grid.Row="0" Grid.Column="0" MinHeight="92"
                  Command="{Binding OpenWorkCardsCommand}">
            <StackPanel Spacing="6">
              <TextBlock Text="▣" FontSize="25" HorizontalAlignment="Center" />
              <TextBlock Text="Work cards" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Row="0" Grid.Column="1" MinHeight="92"
                  Command="{Binding OpenDailyStatusCommand}">
            <StackPanel Spacing="6">
              <TextBlock Text="◷" FontSize="25" HorizontalAlignment="Center" />
              <TextBlock Text="Daily status" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Row="1" Grid.Column="0" MinHeight="92"
                  Command="{Binding OpenEmployeesCommand}">
            <StackPanel Spacing="6">
              <TextBlock Text="♙" FontSize="25" HorizontalAlignment="Center" />
              <TextBlock Text="Employees" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Row="1" Grid.Column="1" MinHeight="92"
                  Command="{Binding OpenSchedulesCommand}">
            <StackPanel Spacing="6">
              <TextBlock Text="▦" FontSize="25" HorizontalAlignment="Center" />
              <TextBlock Text="Work calendar" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>

        <Border Background="#202B3A" CornerRadius="14" Padding="14" IsVisible="{Binding IsEmployeesVisible}">
          <StackPanel Spacing="12">
            <TextBlock Text="EMPLOYEES" Foreground="#8BBCEB" FontWeight="Bold" FontSize="12" />
            <TextBlock Text="{Binding Employees.Count, StringFormat='Active employees: {0}'}" Foreground="White" FontWeight="SemiBold" />
            <ItemsControl ItemsSource="{Binding Employees}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MobileEmployee">
                  <Border Padding="10,9" BorderBrush="#354255" BorderThickness="0,0,0,1">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding FirstName}" Foreground="White" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding LastName}" Foreground="#C3CEDB" FontSize="12" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="No employees are available for the selected company." Foreground="#AAB7C8" IsVisible="{Binding !HasEmployees}" />
          </StackPanel>
        </Border>

        <TextBlock Text="MANAGEMENT" Foreground="#8BBCEB" FontWeight="Bold"
                   FontSize="12" IsVisible="{Binding IsOverviewVisible}" />
        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12" IsVisible="{Binding IsOverviewVisible}">
          <Button Grid.Row="0" Grid.Column="0" MinHeight="76"
                  Command="{Binding OpenOvertimeCommand}" Content="Overtime" />
          <Button Grid.Row="0" Grid.Column="1" MinHeight="76"
                  Command="{Binding OpenSubmissionsCommand}" Content="API submissions" />
          <Button Grid.Row="1" Grid.Column="0" MinHeight="76"
                  Command="{Binding OpenReportsCommand}" Content="Reports" />
          <Button Grid.Row="1" Grid.Column="1" MinHeight="76"
                  Command="{Binding OpenSettingsCommand}" Content="Settings" />
        </Grid>

        <Border Background="#202B3A" CornerRadius="14" Padding="14" IsVisible="{Binding IsOverviewVisible}">
          <StackPanel Spacing="5">
            <TextBlock Text="Mobile app preview" Foreground="White"
                       FontWeight="SemiBold" />
            <TextBlock Text="{Binding StatusMessage}" Foreground="#C3CEDB"
                       FontSize="13" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Margin="14,10" Padding="14" VerticalAlignment="Top"
            HorizontalAlignment="Stretch" Background="#3B2F1D" BorderBrush="#D69B35"
            BorderThickness="1" CornerRadius="12" IsVisible="{Binding HasNotificationPopup}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <StackPanel Grid.Column="0" Spacing="5">
          <TextBlock Text="⚠  ALERT" Foreground="#F0C674" FontWeight="Bold" FontSize="12" />
          <TextBlock Text="{Binding NotificationTitle}" Foreground="White" FontWeight="SemiBold"
                     TextWrapping="Wrap" />
          <TextBlock Text="{Binding NotificationMessage}" Foreground="#E7DCC8"
                     FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="1" Content="×" Command="{Binding DismissNotificationCommand}"
                VerticalAlignment="Top" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
