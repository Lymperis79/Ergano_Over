<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ErganiManager.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Explicit reference so the patched version (see Directory.Packages.props) wins over the vulnerable transitive one. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="BCrypt.Net-Next" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ErganiManager.Data\ErganiManager.Data.csproj" />
    <ProjectReference Include="..\ErganiManager.LocalCache\ErganiManager.LocalCache.csproj" />
    <ProjectReference Include="..\ErganiManager.Licensing\ErganiManager.Licensing.csproj" />
  </ItemGroup>

</Project>
