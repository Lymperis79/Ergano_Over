<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ErganiManager.MobileApi</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Core login evaluates the local offline cache; ensure the SQLite provider is deployed with the API host. -->
